#!/bin/sh
# A stand-in for the installer's ferrum-update (scripts/ferrum-update), for
# SETUP › SOFTWARE screenshots and tests: FERRUM_UPDATER=this file.
# FAKE_UPDATE picks the state: current (default), available, staged, fell-back.
state=${FAKE_UPDATE:-available}
case "$1" in
status) ;;
check|stage|unstage|channel|auto) exit 0 ;;
rollback|use) [ "$2" = "--on-restart" ] || [ "$3" = "--on-restart" ] || { echo "LinuxCNC is running" >&2; exit 1; }; exit 0 ;;
*) echo "unknown command $1" >&2; exit 2 ;;
esac
avail=null; staged=null; fell=null; trial=null
case "$state" in
available) avail='"0.5.0"' ;;
staged) avail='"0.5.0"'; staged='"0.5.0"' ;;
fell-back) avail='"0.5.0"'; fell='"0.5.0 crashed on its first start."' ;;
esac
cat <<JSON
{"installed_in":"/home/cnc/ferrum","current":"0.4.2","previous":"0.4.1","installed":["0.4.2","0.4.1","0.4.0"],
"channel":"stable","auto":false,"available":$avail,"staged":$staged,"on_trial":$trial,"fell_back":$fell,
"skipped":null,"last_check":"2026-11-19T13:58:00Z","last_error":null,"running":true}
JSON
