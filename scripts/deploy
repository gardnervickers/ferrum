#!/usr/bin/env bash
# Build ferrum and install it on the Pi with the same installer users get
# (scripts/ferrum-update): its own version folder, an atomic switch, the
# old build kept for `ferrum-update rollback`, and the crash fallback in
# `run`. It refuses while LinuxCNC runs. mymill.ini and the Probe Basic
# setup are not touched; ../ferrum.ini and ../ferrum.toml (the mymill
# profile) are copied, the Pi's ferrum.toml kept as ferrum.toml.bak.
#
#   FERRUM_PI=user@host FERRUM_DEST=linuxcnc/configs/mymill scripts/deploy
#   FERRUM_DEPLOY_BINARY=path skips the build (tests).
set -euo pipefail
PI="${FERRUM_PI:-cnc@cncmill.localdomain}"
DEST="${FERRUM_DEST:-linuxcnc/configs/mymill}"
cd "$(dirname "$0")/.."
VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' app/Cargo.toml | head -1)-dev.$(date -u +%Y%m%d%H%M).$(git rev-parse --short=7 HEAD 2>/dev/null || echo local)"
git diff --quiet HEAD 2>/dev/null || VERSION="$VERSION.dirty"
BIN="${FERRUM_DEPLOY_BINARY:-}"
if [ -z "$BIN" ]; then
  FERRUM_VERSION="$VERSION" scripts/build
  scripts/build-web >/dev/null
  BIN=target/aarch64-unknown-linux-gnu/release/ferrum
fi
OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT
scripts/package "$BIN" "$VERSION" aarch64 "$OUT" >/dev/null
(cd "$OUT" && shasum -a 256 ferrum-linux-aarch64.tar.gz 2>/dev/null > SHA256SUMS || sha256sum ferrum-linux-aarch64.tar.gz > SHA256SUMS)
# Ferrum was called millgui: move a pre-rename install to ferrum/ and leave
# millgui -> ferrum and millgui.ini -> ferrum.ini links, so launchers and an
# INI SUBROUTINE_PATH that still say millgui keep working.
ssh "$PI" "cd $DEST && if [ -d millgui ] && [ ! -L millgui ] && [ ! -e ferrum ]; then mv millgui ferrum && ln -s ferrum millgui; fi"
ssh "$PI" "mkdir -p $DEST/ferrum && rm -rf /tmp/ferrum-deploy && mkdir -p /tmp/ferrum-deploy"
scp -q "$OUT/ferrum-linux-aarch64.tar.gz" "$OUT/SHA256SUMS" scripts/ferrum-update "$PI:/tmp/ferrum-deploy/"
# The installer refuses while LinuxCNC runs and changes nothing then.
ssh "$PI" "bash /tmp/ferrum-deploy/ferrum-update --prefix $DEST/ferrum --from /tmp/ferrum-deploy/ferrum-linux-aarch64.tar.gz && rm -rf /tmp/ferrum-deploy"
scp -q ../ferrum.ini "$PI:$DEST/"
if [ -f ../ferrum.toml ]; then
  ssh "$PI" "cd $DEST && if [ -f ferrum.toml ]; then cp ferrum.toml ferrum.toml.bak; fi"
  scp -q ../ferrum.toml "$PI:$DEST/"
  if [ -f ../ferrum-outputs.hal ]; then scp -q ../ferrum-outputs.hal "$PI:$DEST/"; fi
fi
ssh "$PI" "cd $DEST && if [ -f millgui.ini ] && [ ! -L millgui.ini ]; then mv millgui.ini millgui.ini.pre-ferrum && ln -s ferrum.ini millgui.ini; fi"
# The JOB page used to run ferrum/job_helper.py; it is built in now.
ssh "$PI" "rm -f $DEST/ferrum/job_helper.py"
echo "deployed Ferrum $VERSION to $PI:$DEST (ferrum-update rollback goes back)"
