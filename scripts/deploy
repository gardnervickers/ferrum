#!/usr/bin/env bash
# Build and copy ferrum to the Pi's config checkout. Only ferrum's own files
# are written; mymill.ini and the Probe Basic setup are not touched.
set -euo pipefail
PI="${FERRUM_PI:-cnc@cncmill.localdomain}"
DEST="${FERRUM_DEST:-linuxcnc/configs/mymill}"
cd "$(dirname "$0")/.."
scripts/build
scripts/build-web >/dev/null
# Ferrum was called millgui: move a pre-rename install to ferrum/ and leave
# millgui -> ferrum and millgui.ini -> ferrum.ini links, so launchers and an
# INI SUBROUTINE_PATH that still say millgui keep working.
ssh "$PI" "cd $DEST && if [ -d millgui ] && [ ! -L millgui ] && [ ! -e ferrum ]; then mv millgui ferrum && ln -s ferrum millgui; fi"
ssh "$PI" "mkdir -p $DEST/ferrum/bin"
scp -q target/aarch64-unknown-linux-gnu/release/ferrum "$PI:$DEST/ferrum/bin/ferrum.new"
scp -q run boot mdi.toml "$PI:$DEST/ferrum/"
# The JOB page used to run ferrum/job_helper.py; it is built in now.
ssh "$PI" "rm -f $DEST/ferrum/job_helper.py"
# machine.toml is edited on the machine: install it only the first time.
ssh "$PI" "test -e $DEST/ferrum/machine.toml" || scp -q machine.toml "$PI:$DEST/ferrum/"
scp -q ../ferrum.ini "$PI:$DEST/"
ssh "$PI" "cd $DEST && if [ -f millgui.ini ] && [ ! -L millgui.ini ]; then mv millgui.ini millgui.ini.pre-ferrum && ln -s ferrum.ini millgui.ini; fi"
ssh "$PI" "mkdir -p $DEST/ferrum/hal"
scp -q hal/*.hal "$PI:$DEST/ferrum/hal/"
ssh "$PI" "rm -rf $DEST/ferrum/web/dist.new && mkdir -p $DEST/ferrum/web/dist.new"
scp -q web/dist/* "$PI:$DEST/ferrum/web/dist.new/"
ssh "$PI" "rm -rf $DEST/ferrum/web/dist && mv $DEST/ferrum/web/dist.new $DEST/ferrum/web/dist"
ssh "$PI" "mv $DEST/ferrum/bin/ferrum.new $DEST/ferrum/bin/ferrum && chmod +x $DEST/ferrum/run $DEST/ferrum/boot"
echo "deployed to $PI:$DEST"
