#!/usr/bin/env bash
# Build and copy millgui to the Pi's config checkout. Only millgui's own files
# are written; mymill.ini and the Probe Basic setup are not touched.
set -euo pipefail
PI="${MILLGUI_PI:-cnc@cncmill.localdomain}"
DEST="${MILLGUI_DEST:-linuxcnc/configs/mymill}"
cd "$(dirname "$0")/.."
scripts/build
scripts/build-web >/dev/null
ssh "$PI" "mkdir -p $DEST/millgui/bin"
scp -q target/aarch64-unknown-linux-gnu/release/millgui "$PI:$DEST/millgui/bin/millgui.new"
scp -q run mdi.toml job_helper.py "$PI:$DEST/millgui/"
# machine.toml is edited on the machine: install it only the first time.
ssh "$PI" "test -e $DEST/millgui/machine.toml" || scp -q machine.toml "$PI:$DEST/millgui/"
scp -q ../millgui.ini "$PI:$DEST/"
ssh "$PI" "mkdir -p $DEST/millgui/hal"
scp -q hal/*.hal "$PI:$DEST/millgui/hal/"
ssh "$PI" "rm -rf $DEST/millgui/web/dist.new && mkdir -p $DEST/millgui/web/dist.new"
scp -q web/dist/* "$PI:$DEST/millgui/web/dist.new/"
ssh "$PI" "rm -rf $DEST/millgui/web/dist && mv $DEST/millgui/web/dist.new $DEST/millgui/web/dist"
ssh "$PI" "mv $DEST/millgui/bin/millgui.new $DEST/millgui/bin/millgui && chmod +x $DEST/millgui/run"
echo "deployed to $PI:$DEST"
