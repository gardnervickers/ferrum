#!/usr/bin/env bash
# Tests for scripts/ferrum-update and run, with stand-in builds (a shell
# script as bin/ferrum) served from a local release folder. Needs no
# LinuxCNC, network or display; runs in a few seconds.
#
#   scripts/test-installer            all tests
#   scripts/test-installer NAME...    tests whose names contain NAME
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$(mktemp -d)"
[ -n "${KEEP_WORK:-}" ] || trap 'rm -rf "$WORK"' EXIT
export HOME="$WORK/home" FERRUM_RELEASES="file://$WORK/releases" FERRUM_NO_BIN_LINK=1
mkdir -p "$HOME"
ARCH="$(case "$(uname -m)" in aarch64|arm64) echo aarch64 ;; *) echo x86_64 ;; esac)"
PASS=0 FAIL=0 FAILED=""

# A stand-in build. Its bin/ferrum answers --version and --check, and
# otherwise does what $WORK/behaviour-<version> says: ok (exit 0), segv,
# panic (exit 101), sleep (until killed). It records each start in $WORK/ran.
fake_pkg() { # version [check-exit] [out-dir]
  local v="$1" chk="${2:-0}" out="${3:-$WORK/pkgs/$1}"
  mkdir -p "$WORK/bins" "$out"
  cat > "$WORK/bins/ferrum-$v" <<EOF
#!/bin/sh
case "\${1:-}" in
  --version) echo "ferrum $v"; exit 0 ;;
  --check) echo "check $v"; exit $chk ;;
esac
echo "$v \${FERRUM_LAUNCH_NOTE:-}" >> "$WORK/ran"
case "\$(cat "$WORK/behaviour-$v" 2>/dev/null || echo ok)" in
  segv) kill -SEGV \$\$ ;;
  panic) exit 101 ;;
  sleep) exec sleep 30 ;;
  *) exit 0 ;;
esac
EOF
  chmod +x "$WORK/bins/ferrum-$v"
  "$ROOT/scripts/package" "$WORK/bins/ferrum-$v" "$v" "$ARCH" "$out" >/dev/null 2>&1
  (cd "$out" && sha256sum "ferrum-linux-$ARCH.tar.gz" > SHA256SUMS && echo "$v" > VERSION)
}

# Publish a stand-in build as release folder <dir> (latest, edge, v1.0.0).
publish() { # dir version [check-exit]
  rm -rf "$WORK/releases/$1"
  if [ "$1" = latest ]; then
    fake_pkg "$2" "${3:-0}" "$WORK/releases/latest/download"
    mkdir -p "$WORK/releases/download"
    rm -rf "$WORK/releases/download/v$2"
    cp -r "$WORK/releases/latest/download" "$WORK/releases/download/v$2"
  else
    fake_pkg "$2" "${3:-0}" "$WORK/releases/download/$1"
  fi
}

P="$WORK/prefix"
upd() { "$ROOT/scripts/ferrum-update" --prefix "$P" "$@"; }
cur() { basename "$(readlink "$P/current")"; }
prev() { basename "$(readlink "$P/previous" 2>/dev/null)" 2>/dev/null; }

ok() { PASS=$((PASS + 1)); printf '  ok    %s\n' "$T"; }
bad() { FAIL=$((FAIL + 1)); FAILED="$FAILED $T"; printf '  FAIL  %s: %s\n' "$T" "$*"; }
expect() { # description command...
  local d="$1"; shift
  "$@" >/dev/null 2>&1 || { bad "$d"; return 1; }
}
eq() { [ "$1" = "$2" ] || { bad "expected '$2', got '$1' ($3)"; return 1; }; }

fresh() {
  rm -rf "$P" "$WORK/releases" "$WORK/ran" "$WORK"/behaviour-*
  mkdir -p "$WORK/releases"
}

# --- tests ------------------------------------------------------------------

t_install() {
  fresh; publish latest 1.0.0
  upd > "$WORK/out" 2>&1 || { bad "install failed: $(cat "$WORK/out")"; return; }
  eq "$(cur)" 1.0.0 current || return
  for f in bin macros hal web mdi.toml; do
    [ -L "$P/$f" ] || { bad "$f is not a link"; return; }
  done
  [ -x "$P/run" ] && [ ! -L "$P/run" ] && [ -x "$P/boot" ] && [ -x "$P/ferrum-update" ] || { bad "run/boot/ferrum-update not copied"; return; }
  [ -f "$P/machine.toml" ] || { bad "machine.toml not installed"; return; }
  eq "$("$P/bin/ferrum" --version)" "ferrum 1.0.0" "bin link" || return
  [ -f "$P/macros/ferrum_touch.ngc" ] || { bad "macros link"; return; }
  grep -q "DISPLAY = $P/run" "$WORK/out" || { bad "no first-steps text"; return; }
  ok
}

t_update_and_rollback() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0
  upd >/dev/null 2>&1 || { bad "update failed"; return; }
  eq "$(cur)" 1.1.0 current || return
  eq "$(prev)" 1.0.0 previous || return
  eq "$(cat "$P/.trial")" 1.1.0 trial || return
  upd rollback >/dev/null 2>&1 || { bad "rollback failed"; return; }
  eq "$(cur)" 1.0.0 "current after rollback" || return
  eq "$(prev)" 1.1.0 "previous after rollback" || return
  [ ! -e "$P/.trial" ] || { bad "rollback left a trial"; return; }
  # The installed updater finds its own prefix.
  "$P/ferrum-update" use 1.1.0 >/dev/null 2>&1 || { bad "use via installed updater"; return; }
  eq "$(cur)" 1.1.0 "use 1.1.0" || return
  ok
}

t_up_to_date() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  upd > "$WORK/out" 2>&1 || { bad "second run failed"; return; }
  grep -q "already installed" "$WORK/out" || { bad "no up-to-date message: $(cat "$WORK/out")"; return; }
  upd check > "$WORK/out" 2>&1
  grep -q "up to date" "$WORK/out" || { bad "check: $(cat "$WORK/out")"; return; }
  publish latest 1.0.1
  upd check > "$WORK/out" 2>&1
  grep -q "1.0.1 is available" "$WORK/out" || { bad "check new: $(cat "$WORK/out")"; return; }
  eq "$(cur)" 1.0.0 "check changes nothing" || return
  ok
}

t_refuses_while_running() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0
  local name
  for name in milltask ferrum rtapi_app; do
    cp "$(command -v sleep)" "$WORK/$name"
    "$WORK/$name" 30 &
    local pid=$!
    sleep 0.2
    if upd > "$WORK/out" 2>&1; then kill $pid; bad "updated while $name ran"; return; fi
    grep -q "is running" "$WORK/out" || { kill $pid; bad "message: $(cat "$WORK/out")"; return; }
    if upd rollback >/dev/null 2>&1; then kill $pid; bad "rolled back while $name ran"; return; fi
    kill $pid; wait $pid 2>/dev/null
    eq "$(cur)" 1.0.0 "unchanged while $name ran" || return
  done
  upd >/dev/null 2>&1 || { bad "update after stopping"; return; }
  eq "$(cur)" 1.1.0 "after stop" || return
  ok
}

t_bad_checksum() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0
  echo garbage >> "$WORK/releases/latest/download/ferrum-linux-$ARCH.tar.gz"
  if upd > "$WORK/out" 2>&1; then bad "installed a damaged download"; return; fi
  grep -q "checksum" "$WORK/out" || { bad "message: $(cat "$WORK/out")"; return; }
  eq "$(cur)" 1.0.0 unchanged || return
  [ ! -d "$P/versions/1.1.0" ] || { bad "damaged version unpacked"; return; }
  ok
}

t_build_that_does_not_start() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0
  # Stand-in for a missing library or the wrong architecture.
  local d="$WORK/broken"; rm -rf "$d"; mkdir -p "$d"
  tar -xzf "$WORK/releases/latest/download/ferrum-linux-$ARCH.tar.gz" -C "$d"
  printf '#!/bin/sh\necho "error while loading shared libraries: libnml.so.0" >&2\nexit 127\n' > "$d/ferrum-1.1.0/bin/ferrum"
  tar -czf "$WORK/releases/latest/download/ferrum-linux-$ARCH.tar.gz" -C "$d" ferrum-1.1.0
  (cd "$WORK/releases/latest/download" && sha256sum "ferrum-linux-$ARCH.tar.gz" > SHA256SUMS)
  if upd > "$WORK/out" 2>&1; then bad "installed a build that does not start"; return; fi
  grep -q "libnml" "$WORK/out" && grep -q "does not start" "$WORK/out" || { bad "message: $(cat "$WORK/out")"; return; }
  eq "$(cur)" 1.0.0 unchanged || return
  ok
}

t_check_regression() {
  fresh; publish latest 1.0.0; touch "$WORK/m.ini"
  upd --ini "$WORK/m.ini" >/dev/null 2>&1
  eq "$(grep ^ini= "$P/.ferrum-install")" "ini=$WORK/m.ini" "ini remembered" || return
  publish latest 1.1.0 1
  if upd > "$WORK/out" 2>&1; then bad "installed a build whose --check got worse"; return; fi
  grep -q "reports a problem that the version in use does not" "$WORK/out" || { bad "message: $(cat "$WORK/out")"; return; }
  eq "$(cur)" 1.0.0 unchanged || return
  upd --force >/dev/null 2>&1 || { bad "--force"; return; }
  eq "$(cur)" 1.1.0 "forced" || return
  # Crashing --check is never installed.
  publish latest 1.2.0 139
  if upd --force >/dev/null 2>&1; then bad "installed a build whose --check crashed"; return; fi
  ok
}

t_crash_falls_back() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0; upd >/dev/null 2>&1
  echo segv > "$WORK/behaviour-1.1.0"
  "$P/run" -ini x.ini > "$WORK/out" 2>&1
  local st=$?
  eq "$st" 0 "run exit (previous build ran)" || return
  eq "$(cur)" 1.0.0 "current after crash" || return
  eq "$(prev)" 1.1.0 "previous after crash" || return
  grep -q "^1.1.0" "$WORK/ran" && grep -q "^1.0.0 Ferrum 1.1.0 crashed" "$WORK/ran" ||
    { bad "ran: $(cat "$WORK/ran")"; return; }
  grep -q "crashed on its first start" "$P/.fell-back" "$P/update.log" || { bad "no record"; return; }
  upd status > "$WORK/out" 2>&1; grep -q "crashed" "$WORK/out" || { bad "status does not say"; return; }
  # A panic too.
  rm -f "$WORK/ran"
  upd use 1.1.0 >/dev/null 2>&1
  echo panic > "$WORK/behaviour-1.1.0"
  "$P/run" > /dev/null 2>&1
  eq "$(cur)" 1.0.0 "current after panic" || return
  ok
}

t_trial_passes() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0; upd >/dev/null 2>&1
  "$P/run" >/dev/null 2>&1 || { bad "run failed"; return; }
  [ ! -e "$P/.trial" ] || { bad "trial not cleared after a clean exit"; return; }
  # Once trusted, a crash is just a crash.
  echo segv > "$WORK/behaviour-1.1.0"
  { "$P/run" >/dev/null 2>&1; } 2>/dev/null; local st=$?
  eq "$st" 139 "crash exit status passed on" || return
  eq "$(cur)" 1.1.0 "no fallback after the trial" || return
  ok
}

t_crash_after_window() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0; upd >/dev/null 2>&1
  echo segv > "$WORK/behaviour-1.1.0"
  FERRUM_TRIAL_SECONDS=0 "$P/run" >/dev/null 2>&1
  eq "$(cur)" 1.1.0 "kept: crashed after the trial time" || return
  [ ! -e "$P/.trial" ] || { bad "trial not cleared"; return; }
  ok
}

t_shutdown_is_not_a_crash() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0; upd >/dev/null 2>&1
  echo sleep > "$WORK/behaviour-1.1.0"
  "$P/run" >/dev/null 2>&1 &
  local pid=$!
  sleep 0.5
  kill -TERM $pid
  wait $pid
  eq "$(cur)" 1.1.0 "kept after TERM" || return
  pkill -f "sleep 30" 2>/dev/null
  ok
}

t_adopt_hand_copied_install() {
  fresh; publish latest 1.0.0
  # What scripts/deploy leaves on the Pi.
  mkdir -p "$P/bin" "$P/hal" "$P/web/dist"
  printf '#!/bin/sh\necho old >> "%s/ran"\n' "$WORK" > "$P/bin/ferrum"; chmod +x "$P/bin/ferrum"
  echo "old hal" > "$P/hal/pendant.hal"; echo old > "$P/web/dist/index.html"
  echo "edited" > "$P/machine.toml"; echo old > "$P/mdi.toml"
  printf '#!/bin/sh\nexec "$(dirname "$0")/bin/ferrum" "$@"\n' > "$P/run"; chmod +x "$P/run"
  upd > "$WORK/out" 2>&1 || { bad "install over old: $(cat "$WORK/out")"; return; }
  eq "$(cur)" 1.0.0 current || return
  eq "$(prev)" pre-installer previous || return
  eq "$(cat "$P/machine.toml")" edited "machine.toml kept" || return
  ls "$P"/backup-*/bin/ferrum "$P"/backup-*/hal/pendant.hal "$P"/backup-*/run >/dev/null 2>&1 || { bad "backup missing"; return; }
  upd rollback >/dev/null 2>&1 || { bad "rollback to the old build"; return; }
  "$P/run"
  grep -q old "$WORK/ran" || { bad "old build did not run after rollback"; return; }
  eq "$(cat "$P/hal/pendant.hal")" "old hal" "old hal after rollback" || return
  # ... and forward again with the updater it kept.
  "$P/ferrum-update" use 1.0.0 >/dev/null 2>&1 || { bad "updater gone after rollback to pre-installer"; return; }
  ok
}

t_prune() {
  fresh
  local v
  for v in 1.0.0 1.0.1 1.0.2 1.0.3 1.0.4 1.0.5; do
    publish latest $v; upd --keep 2 >/dev/null 2>&1 || { bad "install $v"; return; }
    sleep 1 # ls -t has one-second resolution on some filesystems
  done
  eq "$(ls "$P/versions" | tr '\n' ' ')" "1.0.2 1.0.3 1.0.4 1.0.5 " "kept versions" || return
  upd rollback >/dev/null 2>&1; eq "$(cur)" 1.0.4 "rollback after prune" || return
  ok
}

t_edge_channel() {
  fresh; publish latest 1.0.0; publish edge 1.1.0-edge.abc1234
  upd >/dev/null 2>&1; eq "$(cur)" 1.0.0 stable || return
  upd --edge >/dev/null 2>&1 || { bad "edge install"; return; }
  eq "$(cur)" 1.1.0-edge.abc1234 edge || return
  publish edge 1.1.0-edge.def5678
  upd >/dev/null 2>&1; eq "$(cur)" 1.1.0-edge.def5678 "edge remembered" || return
  upd --stable >/dev/null 2>&1; eq "$(cur)" 1.0.0 "back to stable" || return
  publish edge 1.1.0-edge.0000000
  upd >/dev/null 2>&1; eq "$(cur)" 1.0.0 "stable remembered" || return
  publish v0.9.0 0.9.0
  upd --version 0.9.0 >/dev/null 2>&1; eq "$(cur)" 0.9.0 "--version" || return
  ok
}

t_from_file() {
  fresh; fake_pkg 2.0.0 0 "$WORK/local"
  upd --from "$WORK/local/ferrum-linux-$ARCH.tar.gz" > "$WORK/out" 2>&1 || { bad "from: $(cat "$WORK/out")"; return; }
  grep -q "Checksum matches" "$WORK/out" || { bad "SHA256SUMS beside it not used"; return; }
  eq "$(cur)" 2.0.0 current || return
  fake_pkg 2.0.1 0 "$WORK/local2"; rm "$WORK/local2/SHA256SUMS"
  if upd --from "$WORK/local2/ferrum-linux-$ARCH.tar.gz" --sha256 0000 >/dev/null 2>&1; then bad "wrong --sha256 accepted"; return; fi
  upd --from "$WORK/local2/ferrum-linux-$ARCH.tar.gz" --sha256 "$(sha256sum "$WORK/local2/ferrum-linux-$ARCH.tar.gz" | cut -d' ' -f1)" >/dev/null 2>&1 ||
    { bad "right --sha256 refused"; return; }
  eq "$(cur)" 2.0.1 "after --sha256" || return
  ok
}

t_piped_install() {
  fresh; publish latest 1.0.0
  # curl ... | bash -s -- --prefix DIR
  bash -s -- --prefix "$P" < "$ROOT/scripts/ferrum-update" > "$WORK/out" 2>&1 || { bad "piped: $(cat "$WORK/out")"; return; }
  eq "$(cur)" 1.0.0 current || return
  ok
}

t_bin_link() {
  fresh; publish latest 1.0.0
  FERRUM_NO_BIN_LINK= upd >/dev/null 2>&1
  eq "$(readlink "$HOME/.local/bin/ferrum-update")" "$P/ferrum-update" "~/.local/bin link" || return
  "$HOME/.local/bin/ferrum-update" status > "$WORK/out" 2>&1
  grep -q "Ferrum 1.0.0 in $P" "$WORK/out" || { bad "status via ~/.local/bin: $(cat "$WORK/out")"; return; }
  rm -rf "$HOME/.local"
  ok
}

t_auto_update() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  upd auto on >/dev/null 2>&1 || { bad "auto on"; return; }
  publish latest 1.1.0
  "$P/run" >/dev/null 2>&1
  local i; for i in $(seq 50); do [ -f "$P/.staged" ] && break; sleep 0.2; done
  eq "$(cat "$P/.staged" 2>/dev/null)" 1.1.0 "staged in the background" || return
  eq "$(cur)" 1.0.0 "staging changes nothing in use" || return
  # The next start puts it into use, and the screen is told.
  "$P/run" >/dev/null 2>&1
  eq "$(cur)" 1.1.0 "applied at start" || return
  eq "$(prev)" 1.0.0 previous || return
  grep -q "^1.1.0 Updated Ferrum 1.0.0 to 1.1.0" "$WORK/ran" || { bad "ran: $(cat "$WORK/ran")"; return; }
  [ ! -e "$P/.staged" ] || { bad "staged left behind"; return; }
  # At most once a day.
  publish latest 1.2.0
  upd stage --if-due >/dev/null 2>&1
  [ ! -e "$P/.staged" ] || { bad "staged again before it was due"; return; }
  ok
}

t_stage_while_running() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0
  cp "$(command -v sleep)" "$WORK/milltask"; "$WORK/milltask" 30 & local pid=$!
  sleep 0.2
  upd stage > "$WORK/out" 2>&1 || { kill $pid; bad "stage while running: $(cat "$WORK/out")"; return; }
  if upd apply >/dev/null 2>&1; then kill $pid; bad "applied while running"; return; fi
  kill $pid; wait $pid 2>/dev/null
  eq "$(cur)" 1.0.0 "unchanged while running" || return
  upd apply >/dev/null 2>&1 || { bad "apply"; return; }
  eq "$(cur)" 1.1.0 "apply" || return
  ok
}

t_no_restage_after_rollback() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0; upd >/dev/null 2>&1
  upd rollback >/dev/null 2>&1
  upd stage >/dev/null 2>&1
  [ ! -e "$P/.staged" ] || { bad "staged the version rolled back from"; return; }
  publish latest 1.2.0
  upd stage >/dev/null 2>&1
  eq "$(cat "$P/.staged" 2>/dev/null)" 1.2.0 "a newer one is staged" || return
  # Nor one that crashed.
  upd apply >/dev/null 2>&1; echo segv > "$WORK/behaviour-1.2.0"
  "$P/run" >/dev/null 2>&1
  eq "$(cur)" 1.0.0 "fell back" || return
  upd stage >/dev/null 2>&1
  [ ! -e "$P/.staged" ] || { bad "staged the version that crashed"; return; }
  ok
}

t_no_switch_under_boot_screen() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  publish latest 1.1.0; upd stage >/dev/null 2>&1
  cp "$(command -v sleep)" "$WORK/ferrum"; "$WORK/ferrum" 30 & local pid=$!
  sleep 0.2
  "$P/run" >/dev/null 2>&1
  kill $pid; wait $pid 2>/dev/null
  eq "$(cur)" 1.0.0 "not switched while another Ferrum runs" || return
  eq "$(cat "$P/.staged")" 1.1.0 "still staged" || return
  ok
}

json() { python3 -c 'import json,sys; d=json.load(sys.stdin); print(eval(sys.argv[1], {}, {"d": d}))' "$1"; }

t_gui_surface() {
  fresh; publish latest 1.0.0; upd >/dev/null 2>&1
  upd status --json > "$WORK/j" || { bad "status --json failed"; return; }
  eq "$(json 'd["current"], d["staged"], d["auto"], d["channel"], d["running"]' < "$WORK/j")" "('1.0.0', None, False, 'stable', False)" "fresh json" || return
  publish latest 1.1.0
  cp "$(command -v sleep)" "$WORK/milltask"; "$WORK/milltask" 30 & local pid=$!
  sleep 0.2
  # All of these while LinuxCNC runs, and none changes what is in use.
  upd check >/dev/null 2>&1 || { kill $pid; bad "check"; return; }
  upd stage >/dev/null 2>&1 || { kill $pid; bad "stage"; return; }
  upd status --json > "$WORK/j"
  eq "$(json 'd["available"], d["staged"], d["running"], d["installed"]' < "$WORK/j")" "('1.1.0', '1.1.0', True, ['1.1.0', '1.0.0'])" "staged json" || { kill $pid; return; }
  upd unstage >/dev/null 2>&1
  eq "$(json 'd["staged"]' < <(upd status --json))" None "unstaged" || { kill $pid; return; }
  upd use 1.1.0 --on-restart >/dev/null 2>&1 || { kill $pid; bad "use --on-restart"; return; }
  upd channel edge >/dev/null 2>&1; upd auto on >/dev/null 2>&1
  eq "$(json 'd["staged"], d["channel"], d["auto"]' < <(upd status --json))" "('1.1.0', 'edge', True)" "on-restart json" || { kill $pid; return; }
  kill $pid; wait $pid 2>/dev/null
  eq "$(cur)" 1.0.0 "nothing switched while running" || return
  FERRUM_NO_AUTO_UPDATE=1 "$P/run" >/dev/null 2>&1
  eq "$(cur)" 1.1.0 "switched at start" || return
  upd rollback --on-restart >/dev/null 2>&1 || { bad "rollback --on-restart"; return; }
  eq "$(cur)" 1.1.0 "rollback waits" || return
  FERRUM_NO_AUTO_UPDATE=1 "$P/run" >/dev/null 2>&1
  eq "$(cur)" 1.0.0 "rolled back at start" || return
  eq "$(json 'd["skipped"]' < <(upd status --json))" 1.1.0 "skip recorded" || return
  # A failed check is reported.
  FERRUM_RELEASES="file://$WORK/nowhere" upd stage >/dev/null 2>&1
  json 'd["last_error"]' < <(upd status --json) | grep -q "could not reach" || { bad "last_error: $(upd status --json)"; return; }
  json 'd["last_check"]' < <(upd status --json) | grep -q "^20..-..-..T" || { bad "last_check"; return; }
  ok
}

TESTS=(t_install t_update_and_rollback t_up_to_date t_refuses_while_running t_bad_checksum
  t_build_that_does_not_start t_check_regression t_crash_falls_back t_trial_passes
  t_crash_after_window t_shutdown_is_not_a_crash t_adopt_hand_copied_install t_prune
  t_edge_channel t_from_file t_piped_install t_bin_link t_auto_update t_stage_while_running
  t_no_restage_after_rollback t_no_switch_under_boot_screen t_gui_surface)

for T in "${TESTS[@]}"; do
  if [ $# -gt 0 ]; then
    m=""; for a in "$@"; do case "$T" in *"$a"*) m=1 ;; esac; done
    [ -n "$m" ] || continue
  fi
  "$T"
done
echo "$PASS passed, $FAIL failed${FAILED:+:$FAILED}"
[ "$FAIL" = 0 ]
