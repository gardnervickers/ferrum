#!/usr/bin/env bash
# Cross-build millgui for the Pi 5 (Debian 12, glibc 2.36) from macOS or Linux.
# Needs zig + cargo-zigbuild (pulled from nixpkgs) and the rustup
# aarch64-unknown-linux-gnu target.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -d sysroot/usr ] || scripts/fetch-sysroot
SYSROOT="$PWD/sysroot"
export PKG_CONFIG_SYSROOT_DIR="$SYSROOT"
export PKG_CONFIG_LIBDIR="$SYSROOT/usr/lib/aarch64-linux-gnu/pkgconfig:$SYSROOT/usr/share/pkgconfig"
export PKG_CONFIG_ALLOW_CROSS=1
export RUSTFLAGS="${RUSTFLAGS:-} -L $SYSROOT/usr/lib/aarch64-linux-gnu -L $SYSROOT/usr/lib"
TARGET=aarch64-unknown-linux-gnu
exec nix shell nixpkgs#zig nixpkgs#cargo-zigbuild nixpkgs#pkg-config -c \
  cargo zigbuild --release --target "$TARGET.2.36" "$@"
