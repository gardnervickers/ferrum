import { Theme } from "theme.slint";
import { Live, Actions, ConvField } from "state.slint";
import { Btn, Card, Label, H3, Note } from "widgets.slint";
import { ListView } from "std-widgets.slint";

// One input: label left, value well right. A choice opens the picker; a
// number opens the keypad.
component FieldRow inherits Rectangle {
    in property <ConvField> f;
    height: 50px;
    HorizontalLayout {
        spacing: 10px;
        Label { horizontal-stretch: 1; vertical-alignment: center; text: f.label; font-size: 19px; overflow: elide; }
        Rectangle {
            width: 190px;
            background: f.choice ? Theme.raised : Theme.well;
            border-width: 1px;
            border-color: touch.pressed ? Theme.sel : f.choice ? Theme.raised-border : Theme.line;
            border-radius: 6px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                alignment: end;
                Text { vertical-alignment: center; text: f.value; font-family: f.choice ? Theme.display : Theme.body; font-weight: 600; font-size: f.choice ? 24px : 26px; color: Theme.ink; overflow: elide; }
                if f.choice: Text { vertical-alignment: center; text: "▾"; font-size: 20px; color: Theme.muted; }
                if f.unit != "": Text { vertical-alignment: center; text: f.unit; font-family: Theme.body; font-size: 16px; color: Theme.dim; }
            }
            touch := TouchArea { clicked => { Actions.conv-field(f.key); } }
        }
    }
}

export component ConvScreen inherits Rectangle {
    property <bool> locked: Live.manual-locked;
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        Card {
            width: 230px;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                for t in Live.conv-types: Btn { height: 72px; text: t.label; on: t.on; font-size: 24px; clicked => { Actions.conv-type(t.id); } }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 14px;
                    H3 { vertical-alignment: center; text: Live.conv-title; }
                    Label { horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; text: Live.conv-tool; overflow: elide; }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 18px;
                    VerticalLayout {
                        width: 370px;
                        spacing: 6px;
                        Label { text: "SETUP"; color: Theme.dim; }
                        for f in Live.conv-setup: FieldRow { f: f; }
                        Rectangle { vertical-stretch: 1; }
                    }
                    VerticalLayout {
                        width: 370px;
                        spacing: 6px;
                        Label { text: "OPERATION"; color: Theme.dim; }
                        for f in Live.conv-op: FieldRow { f: f; }
                        if Live.conv-show-holes: HorizontalLayout {
                            spacing: 10px;
                            Btn { height: 54px; text: "ADD HOLE"; font-size: 22px; clicked => { Actions.conv-hole-add(); } }
                            Btn { height: 54px; text: "DELETE"; font-size: 22px; enabled: Live.conv-hole-sel >= 0; clicked => { Actions.conv-hole-del(); } }
                        }
                        if Live.conv-show-holes: Rectangle {
                            vertical-stretch: 1;
                            background: Theme.well;
                            border-radius: 6px;
                            ListView {
                                for h[i] in Live.conv-holes: Rectangle {
                                    height: 46px;
                                    background: i == Live.conv-hole-sel ? Theme.sel : ht.pressed ? Theme.raised : transparent;
                                    ht := TouchArea { clicked => { Actions.conv-hole-select(i); } }
                                    Text { x: 12px; vertical-alignment: center; text: h; font-family: Theme.body; font-size: 22px; color: Theme.ink; }
                                }
                            }
                        }
                        if !Live.conv-show-holes: Rectangle { vertical-stretch: 1; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        pic := Rectangle {
                            vertical-stretch: 1;
                            background: Theme.well;
                            border-radius: 6px;
                            clip: true;
                            property <float> sc: min(self.width / 400px, self.height / 300px);
                            property <length> ox: (self.width - 400px * sc) / 2;
                            property <length> oy: (self.height - 300px * sc) / 2;
                            Path {
                                x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                                viewbox-width: 400; viewbox-height: 300;
                                commands: Live.conv-outline;
                                stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                            }
                            Path {
                                x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                                viewbox-width: 400; viewbox-height: 300;
                                commands: Live.conv-path;
                                stroke: #f3c463; stroke-width: 2px; fill: transparent;
                            }
                        }
                        Rectangle {
                            height: 210px;
                            background: Theme.panel2;
                            border-radius: 6px;
                            Text {
                                x: 12px;
                                y: 10px;
                                width: parent.width - 24px;
                                height: parent.height - 20px;
                                text: Live.conv-summary;
                                wrap: word-wrap;
                                font-family: Theme.body;
                                font-size: 20px;
                                color: Live.conv-error ? #ff8f8a : Theme.ink;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Note { horizontal-stretch: 1; vertical-alignment: center; text: "G-code from the mill_ops generators. ADD TO JOB keeps the fields; the JOB page builds the program."; }
                    Btn { width: 260px; text: "LOAD AS PROGRAM"; enabled: !Live.conv-error && !locked; clicked => { Actions.conv-load(); } }
                    Btn { width: 240px; kind: "go"; text: "ADD TO JOB"; enabled: !Live.conv-error && !Live.job-running; clicked => { Actions.conv-add(); } }
                }
            }
        }
    }
}
