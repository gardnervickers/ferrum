import { Theme, Layout } from "theme.slint";
import { Live, Actions, GotoRow } from "state.slint";
import { Btn, EqBtn, Seg, Card, Label, Caption, NumField, H3, Note, Arrows } from "widgets.slint";

// Hold-to-move button: continuous jogs run while pressed, steps fire once.
component JogBtn inherits Btn {
    in property <int> axis;
    in property <int> dir;
    font-size: Theme.t-value;
    enabled: Live.power && !Live.manual-locked;
    pressed => { Actions.jog-start(axis, dir); }
    released => { if Live.jog-step == "CONT" { Actions.jog-stop(axis); } }
}

// Jog controls for the Run screen's JOG tab, beside the backplot.
export component JogPanel inherits VerticalLayout {
    spacing: Theme.row;
    property <length> cw: 94px;
    property <length> ch: 116px;
    property <length> colw: 86px;
    HorizontalLayout {
        spacing: 0px;
        Label { width: 70px; vertical-alignment: center; text: "STEP"; }
        for s[i] in Live.jog-steps: Seg {
            text: s;
            font-size: Theme.t-ctl;
            first: i == 0;
            last: i == Live.jog-steps.length - 1;
            // A browser can only step: a lost release must not leave an axis moving.
            enabled: !(Live.remote && s == "CONT");
            on: Live.jog-step == s && !(Live.remote && s == "CONT");
            clicked => { Actions.jog-step-set(s); }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        padding-top: 6px;
        GridLayout {
            spacing: 14px;
            Row {
                Rectangle { width: cw; height: ch; }
                JogBtn { width: cw; height: ch; icon: Arrows.up; text: "Y+"; axis: 1; dir: 1; }
                Rectangle { width: cw; }
            }
            Row {
                JogBtn { height: ch; icon: Arrows.left; text: "X−"; axis: 0; dir: -1; }
                Btn {
                    height: ch; text: "STOP"; kind: "stop"; font-size: Theme.t-btn;
                    clicked => { Actions.jog-stop(0); Actions.jog-stop(1); Actions.jog-stop(2); if Live.has-rot { Actions.jog-stop(Live.rot-axis); } }
                }
                JogBtn { height: ch; icon: Arrows.right; text: "X+"; axis: 0; dir: 1; }
            }
            Row {
                Rectangle { height: ch; }
                JogBtn { height: ch; icon: Arrows.down; text: "Y−"; axis: 1; dir: -1; }
                Rectangle { }
            }
        }
        VerticalLayout {
            spacing: 14px;
            width: colw;
            JogBtn { height: ch; icon: Arrows.up; text: "Z+"; axis: 2; dir: 1; }
            Rectangle { height: ch; }
            JogBtn { height: ch; icon: Arrows.down; text: "Z−"; axis: 2; dir: -1; }
        }
        if Live.has-rot: VerticalLayout {
            spacing: 14px;
            width: colw;
            JogBtn { height: ch; icon: Arrows.cw; text: Live.rot-letter + "+"; axis: Live.rot-axis; dir: 1; }
            Rectangle { height: ch; }
            JogBtn { height: ch; icon: Arrows.ccw; text: Live.rot-letter + "−"; axis: Live.rot-axis; dir: -1; }
        }
    }
    // The speeds share one row and fill it.
    HorizontalLayout {
        spacing: 10px;
        padding-top: 6px;
        Label { vertical-alignment: center; text: "JOG SPEED"; }
        NumField { horizontal-stretch: 1; value: Live.jog-speed; unit: Live.unit + "/s"; edit => { Actions.edit("jog-speed"); } }
        if Live.has-rot: Rectangle { width: 6px; }
        if Live.has-rot: Label { vertical-alignment: center; text: Live.rot-letter + " SPEED"; }
        if Live.has-rot: NumField { horizontal-stretch: 1; value: Live.jog-speed-a; unit: "°/s"; edit => { Actions.edit("jog-speed-a"); } }
    }
    Rectangle { vertical-stretch: 1; }
    if Live.has-rot && !Live.rot-switch: HorizontalLayout {
        spacing: 12px;
        Note { horizontal-stretch: 1; vertical-alignment: center; text: Live.rot-letter + " has no home switch. Set " + Live.rot-letter + "0 (machine) at the current position."; }
        Btn {
            width: 220px;
            height: Theme.h-ctl;
            text: "SET " + Live.rot-letter + " REF HERE";
            hold: true;
            enabled: Live.power && !Live.manual-locked;
            clicked => { Actions.set-a-reference(); }
        }
    }
    Note { text: "The backplot follows the tool while you jog. Power feed, go to and spindle live on MANUAL."; }
}

component WcsRow inherits HorizontalLayout {
    spacing: 0px;
    Label { width: 120px; vertical-alignment: center; text: "WCS"; }
    for c[i] in Live.wcs-codes: Seg {
        text: c;
        first: i == 0;
        last: i == Live.wcs-codes.length - 1;
        font-size: Theme.t-ctl;
        on: Live.pf-wcs == c;
        enabled: !Live.running;
        clicked => { Actions.pf-wcs-set(c); }
    }
}

component StatusLine inherits Rectangle {
    height: Theme.h-sm;
    background: Theme.well;
    border-radius: Theme.radius-ctl;
    Text {
        x: 14px;
        width: parent.width - 28px;
        vertical-alignment: center;
        overflow: elide;
        text: Live.pf-status;
        font-family: Theme.body;
        font-size: Theme.t-body;
        color: Live.pf-status-error ? Theme.bad : Theme.muted;
    }
}

// End-of-travel moves need the hold; distance moves are one tap.
component FeedBtn inherits Btn {
    in property <int> axis;
    in property <int> dir;
    height: 110px;
    font-size: Theme.t-value;
    hold: Live.pf-mode == "eot";
    enabled: Live.pf-ready && Live.pf-axis-enabled[axis];
    clicked => { Actions.pf-move(axis, dir); }
}

component PowerFeedPanel inherits VerticalLayout {
    spacing: Theme.row;
    WcsRow { }
    HorizontalLayout {
        spacing: 0px;
        Label { width: 120px; vertical-alignment: center; text: "MODE"; }
        Seg { first: true; text: "DISTANCE"; on: Live.pf-mode == "dist"; enabled: !Live.running; clicked => { Actions.pf-mode-set("dist"); } }
        Seg { last: true; text: "END OF TRAVEL"; on: Live.pf-mode == "eot"; enabled: !Live.running; clicked => { Actions.pf-mode-set("eot"); } }
    }
    HorizontalLayout {
        spacing: 0px;
        Label { width: 120px; vertical-alignment: center; text: "FEED"; }
        NumField { horizontal-stretch: 1; value: Live.pf-feed; unit: Live.unit + "/min"; edit => { Actions.edit("pf-feed"); } }
        Rectangle { width: Layout.compact ? 12px : 30px; }
        Label { width: 110px; vertical-alignment: center; text: "DISTANCE"; }
        NumField { horizontal-stretch: 1; value: Live.pf-dist; unit: Live.unit; enabled: Live.pf-mode == "dist"; edit => { Actions.edit("pf-dist"); } }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 40px;
        GridLayout {
            spacing: 12px;
            Row {
                Rectangle { width: 130px; height: 110px; }
                FeedBtn { width: 130px; icon: Arrows.up; text: "Y+"; axis: 1; dir: 1; }
                Rectangle { width: 130px; }
            }
            Row {
                FeedBtn { icon: Arrows.left; text: "X−"; axis: 0; dir: -1; }
                Btn { height: 110px; text: "STOP FEED"; kind: "stop"; clicked => { Actions.motion-stop(); } }
                FeedBtn { icon: Arrows.right; text: "X+"; axis: 0; dir: 1; }
            }
            Row {
                Rectangle { height: 110px; }
                FeedBtn { icon: Arrows.down; text: "Y−"; axis: 1; dir: -1; }
                Rectangle { }
            }
        }
        VerticalLayout {
            spacing: 12px;
            width: 130px;
            FeedBtn { icon: Arrows.up; text: "Z+"; axis: 2; dir: 1; }
            Label {
                height: 110px;
                text: Live.pf-mode == "eot" ? "Z: DIST\nONLY" : "";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            FeedBtn { icon: Arrows.down; text: "Z−"; axis: 2; dir: -1; }
        }
    }
    Note {
        text: Live.pf-mode == "eot"
            ? "Hold to feed X or Y to " + (Live.unit == "in" ? "0.04 in" : "1 mm") + " short of the soft limit. Z moves by distance only."
            : "Feeds the axis by the distance at the set rate, in the selected WCS. The active WCS is unchanged afterwards.";
    }
    Rectangle { vertical-stretch: 1; }
    StatusLine { }
}

component GotoPanel inherits VerticalLayout {
    spacing: Theme.row;
    WcsRow { }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: Theme.row;
            width: 400px;
            HorizontalLayout {
                spacing: 10px;
                Label { width: 150px; vertical-alignment: center; text: "TARGET X"; }
                NumField { horizontal-stretch: 1; value: Live.gt-x; unit: Live.unit; edit => { Actions.edit("gt-x"); } }
            }
            HorizontalLayout {
                spacing: 10px;
                Label { width: 150px; vertical-alignment: center; text: "TARGET Y"; }
                NumField { horizontal-stretch: 1; value: Live.gt-y; unit: Live.unit; edit => { Actions.edit("gt-y"); } }
            }
            HorizontalLayout {
                spacing: 10px;
                Label { width: 150px; vertical-alignment: center; text: "FEED"; }
                NumField { horizontal-stretch: 1; value: Live.gt-feed; unit: Live.unit + "/min"; edit => { Actions.edit("gt-feed"); } }
            }
            Label { text: "SAVED LOCATIONS"; }
            Rectangle {
                vertical-stretch: 1;
                min-height: 140px;
                background: Theme.well;
                border-radius: Theme.radius-ctl;
                clip: true;
                Flickable {
                    content-height: glist.preferred-height;
                    glist := VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;
                        for g[i] in Live.gotos: Rectangle {
                            height: 48px;
                            border-radius: Theme.radius-sm;
                            background: i == Live.goto-selected ? Theme.sel-soft : gt.pressed ? Theme.raised : transparent;
                            border-width: i == Live.goto-selected ? 2px : 0;
                            border-color: Theme.sel;
                            animate background { duration: Theme.quick; }
                            Text {
                                x: 12px;
                                vertical-alignment: center;
                                text: g.name + "   X" + g.x + "  Y" + g.y;
                                font-family: Theme.body;
                                font-weight: 500;
                                font-size: Theme.t-ctl;
                                color: Theme.ink;
                            }
                            gt := TouchArea { clicked => { Actions.goto-select(i); } }
                        }
                        if Live.gotos.length == 0: Note { text: "SAVE stores the target above."; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                EqBtn { text: "SAVE"; clicked => { Actions.goto-save(); } }
                EqBtn { text: "UPDATE"; enabled: Live.goto-selected >= 0; clicked => { Actions.goto-update(); } }
                EqBtn { text: "DELETE"; hold: true; enabled: Live.goto-selected >= 0; clicked => { Actions.goto-delete(); } }
            }
        }
        // XY preview in the selected WCS: saved points, target (ring), origin (cross).
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.well;
            border-radius: Theme.radius-ctl;
            clip: true;
            property <length> side: min(self.width, self.height) - 30px;
            property <length> ox: (self.width - side) / 2;
            property <length> oy: (self.height - side) / 2;
            // The origin cross sits under the points.
            Rectangle { x: ox + side * Live.gt-ox - 12px; y: oy + side * Live.gt-oy; width: 24px; height: 2px; background: Theme.dim; }
            Rectangle { x: ox + side * Live.gt-ox; y: oy + side * Live.gt-oy - 12px; width: 2px; height: 24px; background: Theme.dim; }
            for g[i] in Live.gotos: Rectangle {
                x: ox + side * g.px - 7px;
                y: oy + side * g.py - 7px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: i == Live.goto-selected ? Theme.sel : Theme.muted;
            }
            // The target: a ring in the accent (it is what is chosen, not a warning).
            Rectangle {
                x: ox + side * Live.gt-px - 13px;
                y: oy + side * Live.gt-py - 13px;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                border-width: 3px;
                border-color: Theme.sel;
            }
            // Only the chosen point is named, so names never pile up; it
            // goes to the side of the point with more room.
            for g[i] in Live.gotos: Text {
                visible: i == Live.goto-selected;
                x: g.px > 0.7 ? ox + side * g.px - 20px - self.preferred-width : ox + side * g.px + 20px;
                y: oy + side * g.py - self.preferred-height / 2;
                text: g.name;
                font-family: Theme.body;
                font-weight: 600;
                font-size: Theme.t-small;
                color: Theme.sel-ink;
            }
            Caption { x: 16px; y: 12px; text: Live.pf-wcs + " XY  ·  TOP VIEW"; }
        }
    }
    HorizontalLayout {
        spacing: 40px;
        // A wide gap between a start and its stop, on purpose.
        EqBtn { height: Theme.h-big; text: "GO TO XY"; kind: "go"; hold: true; enabled: Live.pf-ready; clicked => { Actions.goto-go(); } }
        EqBtn { height: Theme.h-big; text: "STOP MOVE"; kind: "stop"; clicked => { Actions.motion-stop(); } }
    }
    StatusLine { }
}

// The right column: three cards, each with its own heading.
component SideColumn inherits VerticalLayout {
    spacing: Theme.gap;
    property <bool> ready: Live.power && Live.homed && !Live.manual-locked;
    Card {
        VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.row;
            H3 { text: "SPINDLE"; }
            HorizontalLayout {
                spacing: 10px;
                Label { vertical-alignment: center; text: "SPEED"; horizontal-stretch: 1; }
                NumField { width: 210px; value: Live.spindle-rpm; unit: "rpm"; enabled: !Live.manual-locked; edit => { Actions.edit("spindle-rpm"); } }
            }
            // STOP stands apart from the starts on either side.
            HorizontalLayout {
                spacing: 32px;
                EqBtn { height: Theme.h-choice; text: "CW"; enabled: Live.power && !Live.manual-locked; clicked => { Actions.spindle(1); } }
                EqBtn { height: Theme.h-choice; text: "STOP"; kind: "stop"; enabled: Live.power; clicked => { Actions.spindle(0); } }
                if Live.spindle-reverse: EqBtn { height: Theme.h-choice; text: "CCW"; enabled: Live.power && !Live.manual-locked; clicked => { Actions.spindle(-1); } }
            }
        }
    }
    Card {
        VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.row;
            H3 { text: "WORK ZERO"; }
            Note { text: "Sets the active WCS so the tool tip is 0 on every axis. Tap ZERO beside an axis on the DRO to zero just that one."; }
            Btn {
                height: Theme.h-big;
                text: "ZERO XYZ HERE";
                enabled: root.ready;
                clicked => { Actions.zero-xyz(); }
            }
        }
    }
    Card {
        vertical-stretch: 1;
        VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.row;
            alignment: start;
            H3 { text: "RETURN"; }
            Note { text: "Each is a move: hold the button until it starts."; }
            Btn {
                height: Theme.h-choice;
                text: "Z TO WORK Z0"; hold: true; font-size: Layout.compact ? Theme.t-body : Theme.t-btn;
                enabled: root.ready;
                clicked => { Actions.z-to-work-zero(); }
            }
            Btn {
                height: Theme.h-choice;
                text: "RETRACT " + (Live.unit == "in" ? "0.4" : "10") + ", XY TO WORK 0"; hold: true; font-size: Layout.compact ? Theme.t-body : Theme.t-btn;
                enabled: root.ready;
                clicked => { Actions.retract-xy-to-zero(); }
            }
            Btn {
                height: Theme.h-choice;
                text: "PARK AT MACHINE HOME"; hold: true; font-size: Layout.compact ? Theme.t-body : Theme.t-btn;
                enabled: root.ready;
                clicked => { Actions.park(); }
            }
        }
    }
}

// MANUAL: power feed and go to, with spindle, zero and the returns. The
// tabs head the left card, as the Run screen's tabs head its panel.
export component ManualScreen inherits Rectangle {
    HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        Card {
            width: Layout.compact ? 640px : 800px;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                HorizontalLayout {
                    spacing: 0px;
                    Seg { first: true; text: "POWER FEED"; on: Live.jog-tab != "goto"; clicked => { Live.jog-tab = "feed"; } }
                    Seg { last: true; text: "GO TO"; on: Live.jog-tab == "goto"; clicked => { Live.jog-tab = "goto"; } }
                }
                if Live.jog-tab != "goto": PowerFeedPanel { vertical-stretch: 1; opacity: 0; init => { self.opacity = 1; } animate opacity { duration: Theme.quick; } }
                if Live.jog-tab == "goto": GotoPanel { vertical-stretch: 1; opacity: 0; init => { self.opacity = 1; } animate opacity { duration: Theme.quick; } }
            }
        }
        SideColumn { horizontal-stretch: 1; }
    }
}
