import { Theme, Layout } from "theme.slint";
import { Live, Actions, JobOp } from "state.slint";
import { Btn, Card, Label, Caption, H3, Note, Pill, Arrows } from "widgets.slint";
import { ListView } from "std-widgets.slint";

component Bar inherits Rectangle {
    in property <float> value;
    in property <string> text;
    height: 30px;
    background: Theme.well;
    border-radius: Theme.radius-sm;
    clip: true;
    // Progress is the accent, as on RUN; green stays a machine action.
    Rectangle { x: 0; width: parent.width * clamp(root.value, 0, 1); background: Theme.sel.with-alpha(0.55); }
    Text { text: root.text; font-family: Theme.body; font-weight: 600; font-size: Theme.t-body; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
}

component OpRow inherits Rectangle {
    in property <JobOp> op;
    in property <int> index;
    height: 84px;
    border-radius: Theme.radius-ctl;
    background: op.selected ? Theme.sel-soft : op.state == "current" ? Theme.good-soft : Theme.panel2;
    animate background { duration: Theme.quick; }
    border-width: op.selected ? 2px : 0px;
    border-color: Theme.sel;
    property <bool> faded: op.state == "skipped" || op.state == "done";
    TouchArea { clicked => { Actions.job-select(root.index); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            width: 120px;
            if op.state != "done" && op.state != "current": Btn {
                height: Theme.h-ctl;
                // Whether the op is part of the job (not "run it now"). A
                // plain plate: the accent edge is for the selected op only.
                font-size: Theme.t-body;
                text: op.enabled ? "INCLUDED" : "SKIPPED";
                enabled: op.can-toggle;
                clicked => { Actions.job-toggle(root.index); }
            }
            if op.state == "done" || op.state == "current": Text {
                text: op.state == "done" ? "DONE" : "NOW";
                horizontal-alignment: center;
                font-family: Theme.display;
                font-size: Theme.t-value;
                letter-spacing: 1.4px;
                color: op.state == "done" ? Theme.muted : Theme.good;
            }
        }
        Text { width: 44px; vertical-alignment: center; horizontal-alignment: center; text: op.pos; font-family: Theme.body; font-weight: 600; font-size: Theme.t-big; color: faded ? Theme.dim : Theme.muted; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 76px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: op.kind == "step" ? Theme.warn-soft : op.kind == "cam" ? Theme.info-soft : Theme.sel-soft;
                    Caption {
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: op.badge;
                        color: op.kind == "step" ? Theme.warn : op.kind == "cam" ? Theme.info : Theme.sel-ink;
                    }
                }
                Text { horizontal-stretch: 1; vertical-alignment: center; text: op.name; font-family: Theme.display; font-size: Theme.t-value; letter-spacing: 1px; color: faded ? Theme.dim : Theme.ink; overflow: elide; }
                if op.stop-after: Pill { text: "STOP AFTER"; kind: "warn"; height: 32px; }
            }
            if op.state != "current": Text { text: op.detail; font-family: Theme.body; font-size: Theme.t-body; color: faded ? Theme.dim : Theme.muted; overflow: elide; }
            if op.state == "current": Bar { value: op.progress; text: op.progress-text; }
        }
    }
}

export component JobScreen inherits Rectangle {
    property <bool> has-sel: Live.job-selected >= 0;
    property <bool> locked: Live.job-running;
    Card {
        x: Theme.gap;
        y: Theme.gap;
        width: parent.width - 2 * Theme.gap;
        height: parent.height - 2 * Theme.gap;
        VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.row;
            HorizontalLayout {
                height: 38px;
                spacing: 14px;
                H3 { horizontal-stretch: 1; vertical-alignment: center; text: Live.job-title; overflow: elide; }
                if Live.job-running: Bar { width: 360px; value: Live.job-fraction; text: "JOB " + round(Live.job-fraction * 100) + "%"; }
                Pill { text: Live.job-state; kind: Live.job-tone; }
            }
            Rectangle {
                vertical-stretch: 1;
                background: Theme.well;
                border-radius: Theme.radius-ctl;
                clip: true;
                // A whole number of rows, so the last one is never cut.
                ListView {
                    y: 4px;
                    height: floor((parent.height - 8px) / 92px) * 92px;
                    for op[i] in Live.job-ops: Rectangle {
                        height: 92px;
                        OpRow { x: 8px; y: 4px; width: parent.width - 16px; op: op; index: i; }
                    }
                }
                if Live.job-ops.length == 0: Note { horizontal-alignment: center; vertical-alignment: center; text: "No operations yet. Add them from CONV or PROBE, or with ADD STEP and ADD PROGRAM below."; }
            }
            if Live.job-check: Rectangle {
                height: 156px;
                background: Theme.panel2;
                border-radius: Theme.radius-ctl;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Label { width: 96px; vertical-alignment: center; text: "CHECK"; }
                        Btn { horizontal-stretch: 1; family: Theme.body; font-size: Theme.t-ctl; cap: "MEASURES"; text: Live.job-check-value; enabled: !locked && Live.job-check-values > 1; clicked => { Actions.job-check-value(); } }
                        Btn { horizontal-stretch: 1; family: Theme.body; font-size: Theme.t-ctl; cap: "NOMINAL"; text: Live.job-check-nominal; enabled: !locked; clicked => { Actions.edit("jc-nominal"); } }
                        Btn { horizontal-stretch: 1; family: Theme.body; font-size: Theme.t-ctl; cap: "TOLERANCE"; text: Live.job-check-tol; enabled: !locked; clicked => { Actions.edit("jc-tol"); } }
                        Btn { horizontal-stretch: 2; family: Theme.body; font-size: Theme.t-ctl; cap: "CUT BY"; text: Live.job-check-op; enabled: !locked; clicked => { Actions.job-check-link(); } }
                        Btn { horizontal-stretch: 1; family: Theme.body; font-size: Theme.t-ctl; cap: "IF OUT"; text: Live.job-check-pause ? "PAUSE" : "KEEP GOING"; on: Live.job-check-pause; enabled: !locked; clicked => { Actions.job-check-pause(); } }
                    }
                    // Always both, so nothing moves when a reading arrives.
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            text: Live.job-check-last;
                            font-family: Theme.body;
                            font-weight: 600;
                            font-size: Theme.t-btn;
                            overflow: elide;
                            color: Live.job-check-tone == "good" ? Theme.good : Live.job-check-tone == "bad" ? Theme.bad : Theme.muted;
                        }
                        Btn {
                            width: 440px;
                            // It edits the tool table: not a machine action, so no fill.
                            family: Theme.body;
                            font-size: Theme.t-ctl;
                            hold: true;
                            cap: "TOOL CORRECTION";
                            text: Live.job-check-adjust != "" ? Live.job-check-adjust : "NONE TO MAKE";
                            enabled: !locked && Live.job-check-adjust != "";
                            clicked => { Actions.job-check-adjust(); }
                        }
                    }
                }
            }
            // Two lines: a refused program says why, and that needs room.
            Text {
                height: 56px;
                vertical-alignment: center;
                text: Live.job-note;
                font-family: Theme.body;
                font-size: Theme.t-body;
                wrap: word-wrap;
                overflow: elide;
                color: Live.job-note-tone == "error" ? Theme.bad : Live.job-note-tone == "warn" ? Theme.warn : Live.job-note-tone == "ready" ? Theme.good : Theme.muted;
            }
            HorizontalLayout {
                height: Theme.h-ctl;
                spacing: 10px;
                Btn { max-width: 150px; preferred-width: 150px; min-width: 90px; horizontal-stretch: 1; text: "NEW"; enabled: !locked; clicked => { Actions.job-new(); } }
                Btn { max-width: 150px; preferred-width: 150px; min-width: 90px; horizontal-stretch: 1; text: "OPEN"; enabled: !locked; clicked => { Actions.job-open(); } }
                Btn { max-width: 190px; preferred-width: 190px; min-width: 114px; horizontal-stretch: 1; text: "ADD STEP"; enabled: !locked; clicked => { Actions.job-add-step(); } }
                Btn { max-width: 230px; preferred-width: 230px; min-width: 138px; horizontal-stretch: 1; text: "ADD PROGRAM"; enabled: !locked; clicked => { Actions.job-add-program(); } }
                Btn { max-width: 96px; preferred-width: 96px; min-width: 58px; horizontal-stretch: 1; icon: Arrows.up; enabled: !locked && has-sel; clicked => { Actions.job-move(-1); } }
                Btn { max-width: 96px; preferred-width: 96px; min-width: 58px; horizontal-stretch: 1; icon: Arrows.down; enabled: !locked && has-sel; clicked => { Actions.job-move(1); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { max-width: 190px; preferred-width: 190px; min-width: 114px; horizontal-stretch: 1; text: "DELETE OP"; hold: true; enabled: !locked && has-sel; clicked => { Actions.job-delete(); } }
            }
            HorizontalLayout {
                height: Theme.h-ctl;
                spacing: 10px;
                Btn { max-width: 260px; preferred-width: 260px; min-width: 156px; horizontal-stretch: 1; text: "START AT OP"; enabled: !locked && has-sel; clicked => { Actions.job-start-at(); } }
                Btn { max-width: 320px; preferred-width: 320px; min-width: 192px; horizontal-stretch: 1; text: "STOP AFTER THIS OP"; on: Live.job-stop-requested; enabled: Live.job-running; clicked => { Actions.job-stop-after(); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { max-width: 460px; preferred-width: 460px; min-width: 276px; horizontal-stretch: 1; hold: true; text: "BUILD AND LOAD"; enabled: !locked && Live.job-ops.length > 0; clicked => { Actions.job-build(); } }
            }
        }
    }
}
