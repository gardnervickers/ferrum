import { Theme, Layout } from "theme.slint";
import { Live, Actions, WarmStage, StatusRow } from "state.slint";
import { Btn, EqBtn, Card, Label, Caption, Kv, NumField, H3, Note, Pill } from "widgets.slint";
import { Brand, Lockup } from "brand.slint";

// A fact tile, with the value in its status tone.
component Cell inherits Kv {
    in property <string> key;
    in property <string> kind;
    label: key;
    inset: true;
    min-width: 0px;
    tone: kind == "good" ? Theme.good : kind == "warn" ? Theme.warn : kind == "bad" ? Theme.bad : Theme.ink;
}

export component UtilScreen inherits Rectangle {
    HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        Card {
            width: Layout.compact ? 560px : 680px;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                H3 { text: "SPINDLE WARM-UP"; }
                Note { text: Live.wu-note; }
                Btn {
                    text: "TOOL HOLDER SECURE";
                    sub: Live.wu-secure ? "CONFIRMED" : "TAP TO CONFIRM";
                    on: Live.wu-secure;
                    enabled: !Live.wu-running;
                    clicked => { Actions.wu-secure(); }
                }
                // Same widths as the rows below (the card is 680 px, 560 compact), so
                // every row splits at the same x.
                HorizontalLayout {
                    spacing: 10px;
                    for st[i] in Live.wu-stages: Rectangle {
                        max-width: 154px; preferred-width: 154px; min-width: 92px; horizontal-stretch: 1;
                        height: 146px;
                        border-radius: Theme.radius-ctl;
                        background: st.state == "run" ? Theme.good-soft : Theme.panel2;
                        border-width: st.state == "run" ? 2px : 0;
                        border-color: Theme.go-border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            Caption { height: 20px; vertical-alignment: center; text: "STAGE " + (i + 1) + (st.state == "done" ? "  ·  DONE" : st.state == "run" ? "  ·  NOW" : ""); color: st.state == "run" ? Theme.good : Theme.dim; }
                            // The shared number field: value right, unit small after it.
                            NumField { height: Theme.h-sm; value: st.rpm; unit: "rpm"; enabled: !Live.wu-running; edit => { Actions.edit("wu-rpm-" + i); } }
                            NumField { height: Theme.h-sm; value: st.minutes; unit: "min"; enabled: !Live.wu-running; edit => { Actions.edit("wu-min-" + i); } }
                        }
                    }
                }
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.well;
                    Rectangle { x: 0; width: parent.width * Live.wu-progress; border-radius: 4px; background: Theme.sel; }
                }
                Note { height: 26px; wrap: no-wrap; overflow: elide; vertical-alignment: center; text: Live.wu-text; }
                // Fixed slot so START/STOP never move.
                Text { height: 26px; overflow: elide; font-family: Theme.body; font-size: Theme.t-body; color: Theme.warn; text: !Live.wu-running ? Live.wu-ready : ""; }
                // A wide gap between the stop and its start, on purpose.
                HorizontalLayout {
                    height: Theme.h-choice;
                    spacing: 32px;
                    EqBtn { kind: "stop"; text: "STOP"; enabled: Live.wu-running; clicked => { Actions.wu-stop(); } }
                    EqBtn { kind: "go"; text: "START WARM-UP"; enabled: !Live.wu-running && Live.wu-ready == ""; clicked => { Actions.wu-start(); } }
                }
                H3 { text: "SPINDLE AND TOOL SETTER"; }
                // Gone when empty, or it takes a share of the free height.
                if Live.ut-has-blast || Live.ut-has-nose: HorizontalLayout {
                    spacing: 10px;
                    if Live.ut-has-blast: Btn { max-width: 320px; preferred-width: 320px; min-width: 192px; horizontal-stretch: 1; text: "TOOLSETTER BLAST"; hold: true; enabled: Live.ut-has-blast; on: Live.ut-blast; clicked => { Actions.ut-blast(); } }
                    if Live.ut-has-nose: Btn {
                        max-width: 320px; preferred-width: 320px; min-width: 192px; horizontal-stretch: 1;
                        text: "PROBE SPINDLE NOSE";
                        clicked => {
                            Actions.probe-mode("cal");
                            Actions.probe-shape("nose");
                            Actions.navigate("probe");
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Btn { max-width: 320px; preferred-width: 320px; min-width: 192px; horizontal-stretch: 1; text: "GO TO G30"; sub: "TOOL SETTER"; enabled: Live.power && !Live.manual-locked; clicked => { Actions.ut-go-g30(); } }
                    Btn { max-width: 320px; preferred-width: 320px; min-width: 192px; horizontal-stretch: 1; text: "SET G30 HERE"; hold: true; enabled: Live.power && !Live.manual-locked; clicked => { Actions.ut-set-g30(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    if Live.ut-has-nose: Cell { width: Layout.compact ? 150px : 180px; key: "NOSE REF"; value: Live.ut-nose; kind: Live.ut-nose-kind; }
                    Cell { width: Layout.compact ? 120px : 150px; key: "SETTER"; value: Live.ut-setter; }
                    Cell { horizontal-stretch: 1; key: "G30 POSITION"; value: Live.ut-g30; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                H3 { text: "MACHINE STATUS"; }
                GridLayout {
                    spacing: 10px;
                    for r[i] in Live.ut-status: Cell { col: mod(i, 3); row: floor(i / 3); key: r.key; value: r.value; kind: r.kind; }
                }
                Note { text: "From LinuxCNC status and the machine's HAL signals."; }
                Rectangle { vertical-stretch: 1; }
                // The product's mark and version, quietly at the foot.
                HorizontalLayout {
                    spacing: 20px;
                    Lockup { size: 64px; }
                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: bottom;
                        text: "v" + Brand.version;
                        font-family: Theme.body;
                        font-size: Theme.t-body;
                        color: Theme.dim;
                    }
                }
            }
        }
    }
}
