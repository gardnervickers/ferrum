// Colors and fonts from rust_gui/mockup.html.
import "../fonts/BebasNeue-Regular.ttf";
import "../fonts/BarlowCondensed-Regular.ttf";
import "../fonts/BarlowCondensed-Medium.ttf";
import "../fonts/BarlowCondensed-SemiBold.ttf";
// Arrows, ⌫, ✓ and the like (a DejaVu Sans subset): the text fonts lack them
// and the browser build has no system fallback fonts.
import "../fonts/MillSymbols.ttf";

export global Theme {
    out property <color> page: #121517;
    out property <color> frame: #1b1f22;
    out property <color> bar: #15181a;
    out property <color> panel: #24292d;
    out property <color> panel2: #2d3338;
    out property <color> raised: #383f45;
    out property <color> raised-border: #4a535a;
    out property <color> line: #3d454b;
    out property <color> well: #0f1214;
    out property <color> ink: #e8ebed;
    out property <color> muted: #97a1a8;
    out property <color> dim: #6b747b;
    out property <color> sel: #6d7cff;
    out property <color> go: #2e9a57;
    out property <color> go-border: #3fb86b;
    out property <color> hold: #8a6512;
    out property <color> hold-border: #d99a1e;
    out property <color> stop: #8f2b28;
    out property <color> stop-border: #cf4440;
    out property <string> display: "Bebas Neue";
    out property <string> body: "Barlow Condensed";
}
