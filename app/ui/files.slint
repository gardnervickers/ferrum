import { Theme, Layout } from "theme.slint";
import { Live, Actions, FileRow, FileOp } from "state.slint";
import { Btn, Seg, Card, Label, Caption, Chevron, H3, Note } from "widgets.slint";
import { ListView } from "std-widgets.slint";

export component FilesScreen inherits Rectangle {
    // The backplot's op colours (preview::software::OP_COLORS).
    property <[color]> op-colors: Theme.op-colors;
    HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        Card {
            horizontal-stretch: 1.4;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                HorizontalLayout {
                    H3 { horizontal-stretch: 1; text: "PROGRAMS"; }
                    Label { vertical-alignment: center; text: Live.files-path; }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Label { horizontal-stretch: 1; text: "NAME"; }
                    Label { width: Layout.compact ? 80px : 120px; horizontal-alignment: right; text: "SIZE"; }
                    Label { width: Layout.compact ? 150px : 200px; horizontal-alignment: right; text: "MODIFIED"; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    // A whole number of rows, so the last one is never cut.
                    ListView {
                        y: 4px;
                        height: floor((parent.height - 8px) / 56px) * 56px;
                        for f[i] in Live.files: Rectangle {
                            height: 56px;
                            background: i == Live.files-selected ? Theme.sel-soft : ft.pressed ? Theme.raised : transparent;
                            border-radius: Theme.radius-sm;
                            border-width: i == Live.files-selected ? 2px : 0;
                            border-color: Theme.sel;
                            animate background { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                // A folder opens: the same chevron as every row that goes somewhere.
                                if f.dir: VerticalLayout { alignment: center; Chevron { dir: "right"; } }
                                Text { horizontal-stretch: 1; vertical-alignment: center; text: f.name; font-family: Theme.body; font-weight: 500; font-size: Theme.t-btn; color: Theme.ink; overflow: elide; }
                                Text { width: Layout.compact ? 80px : 120px; horizontal-alignment: right; vertical-alignment: center; text: f.size; font-family: Theme.body; font-size: Theme.t-body; color: i == Live.files-selected ? Theme.sel-ink : Theme.muted; }
                                Text { width: Layout.compact ? 150px : 200px; horizontal-alignment: right; vertical-alignment: center; text: f.modified; font-family: Theme.body; font-size: Theme.t-body; color: i == Live.files-selected ? Theme.sel-ink : Theme.muted; }
                            }
                            ft := TouchArea { clicked => { Actions.files-tap(i); } }
                        }
                    }
                    if Live.files.length == 0: Note { horizontal-alignment: center; vertical-alignment: center; text: "No G-code files here."; }
                }
                HorizontalLayout {
                    height: Theme.h-ctl;
                    spacing: 10px;
                    Btn { max-width: 220px; preferred-width: 220px; min-width: 132px; horizontal-stretch: 1; text: "FOLDER UP"; enabled: Live.files-can-up; clicked => { Actions.files-up(); } }
                    Btn { max-width: 180px; preferred-width: 180px; min-width: 108px; horizontal-stretch: 1; text: "REFRESH"; clicked => { Actions.files-refresh(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        width: Layout.compact ? 180px : 240px;
                        text: "LOAD";
                        enabled: Live.files-name != "" && !Live.running;
                        clicked => { Actions.files-load(); }
                    }
                }
            }
        }
        // Fixed width: a long file name elides instead of resizing the screen.
        // Every slot below has a fixed height, so picking a file, an op or
        // the other tab changes what is in a slot and never moves one.
        Card {
            width: Layout.compact ? 480px : 640px;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                H3 { height: 34px; vertical-alignment: center; text: Live.files-name == "" ? "SELECT A FILE" : Live.files-name; overflow: elide; }
                HorizontalLayout {
                    height: Theme.h-sm;
                    spacing: 12px;
                    Label { horizontal-stretch: 1; vertical-alignment: center; text: Live.files-summary; overflow: elide; }
                    HorizontalLayout {
                        width: Layout.compact ? 220px : 260px;
                        spacing: 0;
                        Seg { first: true; text: "TOP VIEW"; font-size: Theme.t-body; on: Live.files-tab == "plot"; clicked => { Live.files-tab = "plot"; } }
                        Seg { last: true; text: "G-CODE"; font-size: Theme.t-body; on: Live.files-tab == "code"; clicked => { Live.files-tab = "code"; } }
                    }
                }
                // The program from above, or its text. The picture is drawn
                // by Rust at this well's size.
                well := Rectangle {
                    height: 360px;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    Timer {
                        interval: 250ms;
                        running: true;
                        triggered => { Actions.files-plot-resize(well.width / 1px, well.height / 1px); }
                    }
                    changed width => { Actions.files-plot-resize(well.width / 1px, well.height / 1px); }
                    if Live.files-tab == "plot": pic := Rectangle {
                        opacity: 0; init => { self.opacity = 1; } animate opacity { duration: Theme.quick; }
                        property <bool> drawn: Live.files-name != "" && Live.files-status == "" && !Live.remote;
                        Image { visible: pic.drawn; width: parent.width; height: parent.height; source: Live.files-plot; image-fit: fill; }
                        // Work zero, named in the corner its two axis lines make.
                        if pic.drawn && Live.files-zero-x >= 0: Text {
                            x: Live.files-zero-x * parent.width + 6px;
                            y: Live.files-zero-y * parent.height - self.height - 3px;
                            text: "X0 Y0";
                            font-family: Theme.body;
                            font-size: Theme.t-cap;
                            color: Theme.muted;
                        }
                        Caption {
                            x: 16px; y: 12px;
                            width: parent.width - 32px;
                            visible: pic.drawn;
                            text: Live.files-op >= 0 ? "TOP VIEW  ·  OP " + (Live.files-op + 1) + "  ·  TAP IT AGAIN FOR ALL" : "TOP VIEW  ·  TAP AN OP TO PICK IT OUT";
                            overflow: elide;
                        }
                        Text {
                            x: 16px; y: parent.height - self.height - 10px;
                            width: parent.width - 32px;
                            visible: pic.drawn;
                            text: Live.files-extent;
                            font-family: Theme.body;
                            font-size: Theme.t-cap;
                            color: Theme.muted;
                            overflow: elide;
                        }
                        Note {
                            x: 24px;
                            width: parent.width - 48px;
                            height: parent.height;
                            visible: !pic.drawn;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: Live.files-name == "" ? "Pick a program to see it from above." : Live.remote && Live.files-status == "" ? "The picture shows on the mill's screen." : Live.files-status;
                        }
                    }
                    if Live.files-tab == "code": Flickable {
                        opacity: 0; init => { self.opacity = 1; } animate opacity { duration: Theme.quick; }
                        content-height: pv.preferred-height + 16px;
                        pv := Text {
                            x: 12px;
                            y: 8px;
                            text: Live.files-preview;
                            font-family: Theme.body;
                            font-size: Theme.t-body;
                            color: Theme.muted;
                        }
                    }
                }
                // Ops with tool and estimated time; a tap picks one out in
                // the picture.
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    background: Theme.panel2;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    ListView {
                        y: 4px;
                        height: floor((parent.height - 8px) / 56px) * 56px;
                        for o[i] in Live.files-ops: Rectangle {
                            height: 56px;
                            background: i == Live.files-op ? Theme.sel-soft : ot.pressed ? Theme.raised : transparent;
                            border-radius: Theme.radius-sm;
                            border-width: i == Live.files-op ? 2px : 0;
                            border-color: Theme.sel;
                            animate background { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle { width: 18px; height: 18px; border-radius: Theme.radius-sm - 2px; background: root.op-colors[mod(o.color, 6)]; }
                                }
                                Text { horizontal-stretch: 1; vertical-alignment: center; text: o.name; font-family: Theme.body; font-size: Theme.t-ctl; color: Theme.ink; overflow: elide; }
                                Text { width: 64px; horizontal-alignment: right; vertical-alignment: center; text: o.tool; font-family: Theme.body; font-weight: 600; font-size: Theme.t-body; color: i == Live.files-op ? Theme.sel-ink : Theme.muted; }
                                Text { width: 92px; horizontal-alignment: right; vertical-alignment: center; text: o.time; font-family: Theme.body; font-size: Theme.t-body; color: i == Live.files-op ? Theme.sel-ink : Theme.muted; }
                            }
                            ot := TouchArea { clicked => { Actions.files-op-tap(i); } }
                        }
                    }
                    if Live.files-ops.length == 0: Note { horizontal-alignment: center; vertical-alignment: center; text: Live.files-name == "" || Live.files-status != "" ? "" : "No ops to list."; }
                }
                // One line, always there: a partial read says so in amber.
                Note {
                    height: 24px;
                    wrap: no-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Live.files-warning != "" ? Theme.warn : Theme.muted;
                    text: Live.files-warning != "" ? Live.files-warning : "Times are estimates from feed rates, without acceleration.";
                }
            }
        }
    }
}
