import { Theme } from "theme.slint";
import { Live, Actions, FileRow } from "state.slint";
import { Btn, Card, Label, H3, Note } from "widgets.slint";
import { ListView } from "std-widgets.slint";

export component FilesScreen inherits Rectangle {
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        Card {
            horizontal-stretch: 1.4;
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                HorizontalLayout {
                    H3 { horizontal-stretch: 1; text: "PROGRAMS"; }
                    Label { vertical-alignment: center; text: Live.files-path; }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Label { horizontal-stretch: 1; text: "NAME"; }
                    Label { width: 120px; horizontal-alignment: right; text: "SIZE"; }
                    Label { width: 200px; horizontal-alignment: right; text: "MODIFIED"; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    ListView {
                        for f[i] in Live.files: Rectangle {
                            height: 58px;
                            background: i == Live.files-selected ? Theme.sel-soft : ft.pressed ? Theme.raised : transparent;
                            border-radius: Theme.radius-sm;
                            border-width: i == Live.files-selected ? 2px : 0;
                            border-color: Theme.sel;
                            animate background { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text { horizontal-stretch: 1; vertical-alignment: center; text: (f.dir ? "▸ " : "") + f.name; font-family: Theme.body; font-size: 24px; color: Theme.ink; overflow: elide; }
                                Text { width: 120px; horizontal-alignment: right; vertical-alignment: center; text: f.size; font-family: Theme.body; font-size: 20px; color: i == Live.files-selected ? Theme.sel-ink : Theme.muted; }
                                Text { width: 200px; horizontal-alignment: right; vertical-alignment: center; text: f.modified; font-family: Theme.body; font-size: 20px; color: i == Live.files-selected ? Theme.sel-ink : Theme.muted; }
                            }
                            ft := TouchArea { clicked => { Actions.files-tap(i); } }
                        }
                    }
                    if Live.files.length == 0: Note { horizontal-alignment: center; vertical-alignment: center; text: "No G-code files here."; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Btn { width: 220px; text: "FOLDER UP"; enabled: Live.files-can-up; clicked => { Actions.files-up(); } }
                    Btn { width: 180px; text: "REFRESH"; clicked => { Actions.files-refresh(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        width: 240px;
                        text: "LOAD";
                        enabled: Live.files-name != "" && !Live.running;
                        clicked => { Actions.files-load(); }
                    }
                }
            }
        }
        // Fixed width: a long file name elides instead of resizing the screen.
        Card {
            width: 540px;
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                H3 { text: Live.files-name == "" ? "SELECT A FILE" : Live.files-name; overflow: elide; }
                // Ops and estimated times from the interpreter; fixed height
                // so the preview below never moves.
                Rectangle {
                    height: 380px;
                    background: Theme.panel2;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    sf := Flickable {
                        content-height: sm.preferred-height + 16px;
                        sm := Text {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            text: Live.files-summary;
                            font-family: Theme.body;
                            font-size: 21px;
                            color: Theme.ink;
                        }
                    }
                    // More ops below: fade the last row and say so.
                    if sf.content-height > sf.height && sf.content-y > sf.height - sf.content-height + 4px: Rectangle {
                        y: parent.height - 44px;
                        height: 44px;
                        background: Theme.panel2;
                        Rectangle { y: 0; height: 1px; background: Theme.line; }
                        Text {
                            x: parent.width - self.width - 12px;
                            y: parent.height - self.height - 6px;
                            text: "SCROLL FOR MORE";
                            font-family: Theme.body;
                            font-size: 16px;
                            color: Theme.dim;
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    Flickable {
                        content-height: pv.preferred-height;
                        pv := Text {
                            x: 12px;
                            y: 8px;
                            text: Live.files-preview;
                            font-family: Theme.body;
                            font-size: 19px;
                            color: Theme.muted;
                        }
                    }
                }
                Note { text: "Times are estimates from feed rates, without acceleration."; }
            }
        }
    }
}
