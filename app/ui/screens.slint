import { Theme } from "theme.slint";
import { Live, Actions, MdiCard } from "state.slint";
import { Card, Label, Btn, Seg, Note, H3 } from "widgets.slint";
import { ListView } from "std-widgets.slint";
import { JogPanel } from "jog.slint";

// Placeholder for screens that later milestones fill in.
export component Placeholder inherits Rectangle {
    in property <string> title;
    in property <string> note;
    Card {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                horizontal-alignment: center;
                text: title;
                font-family: Theme.display;
                font-size: 48px;
                letter-spacing: 2px;
                color: Theme.ink;
            }
            Text {
                horizontal-alignment: center;
                text: note;
                font-family: Theme.body;
                font-size: 24px;
                color: Theme.muted;
            }
        }
    }
}

component KeyBtn inherits Btn {
    height: 54px;
    font-size: self.text == "SPACE" || self.text == "CLR" ? 20px : 28px;
    enabled: Live.power && !Live.manual-locked;
    clicked => { Actions.mdi-key(self.text); }
}

// MDI (mockup v17, stacked to fit the Run screen's right panel beside the
// backplot): command line, help, library by category, G-code keypad.
component MdiPanel inherits VerticalLayout {
    spacing: 12px;
    property <bool> unlocked: Live.power && !Live.manual-locked;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            horizontal-stretch: 1;
            height: 72px;
            background: Theme.well;
            border-width: 1px;
            border-color: input.has-focus ? Theme.sel : Theme.line;
            border-radius: 6px;
            input := TextInput {
                x: 16px;
                width: parent.width - 32px;
                vertical-alignment: center;
                text <=> Live.mdi-text;
                font-family: Theme.display;
                font-size: 36px;
                letter-spacing: 1px;
                color: Theme.ink;
                enabled: unlocked;
                edited => { Actions.mdi-edited(); }
                accepted => { Actions.mdi-send(self.text); }
            }
        }
        Btn {
            width: 130px;
            height: 72px;
            text: "SEND";
            kind: "go";
            font-size: 28px;
            enabled: unlocked && Live.mdi-text != "";
            clicked => { Actions.mdi-send(Live.mdi-text); }
        }
    }
    Text {
        height: 28px;
        overflow: elide;
        text: Live.manual-locked ? "MDI is locked while a program runs or is paused." : Live.mdi-help;
        font-family: Theme.body;
        font-size: 19px;
        color: Theme.muted;
    }
    HorizontalLayout {
        spacing: 0px;
        for c in Live.mdi-categories: Seg {
            text: c;
            on: Live.mdi-category == c;
            clicked => { Actions.mdi-category-set(c); }
        }
    }
        Flickable {
            vertical-stretch: 1;
            content-height: grid.preferred-height;
            grid := VerticalLayout {
                spacing: 10px;
                alignment: start;
                for row in (Live.mdi-cards.length + 1) / 2: HorizontalLayout {
                    spacing: 10px;
                    for col in 2: Rectangle {
                        property <int> i: row * 2 + col;
                        property <MdiCard> card: Live.mdi-cards[i];
                        horizontal-stretch: 1;
                        height: 70px;
                        border-radius: 6px;
                        background: i >= Live.mdi-cards.length ? transparent : ct.pressed && unlocked ? Theme.sel : Theme.raised;
                        border-width: i >= Live.mdi-cards.length ? 0 : 1px;
                        border-color: Theme.raised-border;
                        opacity: unlocked ? 1 : 0.38;
                        if i < Live.mdi-cards.length: VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: card.label; font-family: Theme.display; font-size: 26px; letter-spacing: 1px; color: Theme.ink; overflow: elide; }
                                if card.moves: Text { vertical-alignment: center; text: "· MOVES"; font-family: Theme.display; font-size: 18px; color: #f2c14e; }
                            }
                            if card.desc != "": Text { text: card.desc; font-family: Theme.body; font-size: 17px; color: Theme.muted; overflow: elide; }
                        }
                        ct := TouchArea {
                            enabled: unlocked && i < Live.mdi-cards.length;
                            clicked => { Actions.mdi-pick(card.fill); }
                        }
                    }
                }
                if Live.mdi-cards.length == 0: Note { text: Live.mdi-category == "RECENT" ? "Commands you send appear here." : "No entries in this category."; }
            }
        }
        GridLayout {
                spacing: 8px;
                Row { for k in ["G", "M", "X", "Y", "Z"]: KeyBtn { text: k; } }
                Row { for k in ["A", "F", "S", "T", "H"]: KeyBtn { text: k; } }
                Row { for k in ["P", "Q", "L", "R", "."]: KeyBtn { text: k; } }
                Row { for k in ["7", "8", "9", "−", "⌫"]: KeyBtn { text: k; } }
                Row { for k in ["4", "5", "6", "SPACE", "CLR"]: KeyBtn { text: k; } }
                Row { for k in ["1", "2", "3", "0"]: KeyBtn { text: k; } }
        }
}

// One G-code line; fixed height so the ListView only creates visible rows.
component GLine inherits Rectangle {
    in property <int> n;
    in property <string> code;
    in property <bool> current;
    in property <bool> picked;
    callback tapped();
    height: 32px;
    background: current ? #2b3a6b : picked ? Theme.raised : transparent;
    HorizontalLayout {
        padding-left: 8px;
        spacing: 12px;
        Text { width: 70px; horizontal-alignment: right; vertical-alignment: center; text: n; font-family: Theme.body; font-size: 18px; color: Theme.dim; }
        Text { vertical-alignment: center; text: code; font-family: Theme.body; font-size: 21px; color: current ? Theme.ink : Theme.muted; overflow: elide; }
    }
    TouchArea { clicked => { root.tapped(); } }
}

component ProgramCard inherits Card {
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            H3 { horizontal-stretch: 1; text: Live.program == "" ? "NO PROGRAM LOADED" : Live.program; overflow: elide; }
            Label { vertical-alignment: center; text: "LINE " + min(Live.line, Live.gcode-count) + " / " + Live.gcode-count; }
        }
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.well;
            Rectangle {
                x: 0;
                width: Live.gcode-count == 0 ? 0 : parent.width * min(1, Live.line / Live.gcode-count);
                border-radius: 4px;
                background: Theme.sel;
            }
        }
        plot-area := Rectangle {
            vertical-stretch: 1;
            background: Theme.well;
            border-radius: 6px;
            clip: true;
            // Report the size a few times a second; Rust redraws only when it
            // changes. (`changed width` misses the first layout.)
            Timer {
                interval: 250ms;
                running: true;
                triggered => { Actions.plot-resize(plot-area.width / 1px, plot-area.height / 1px); }
            }
            Image { width: parent.width; height: parent.height; source: Live.plot; image-fit: fill; }
            if Live.program == "": Note { horizontal-alignment: center; vertical-alignment: center; text: "Load a program on FILES."; }
            Text {
                x: 14px; y: parent.height - self.height - 10px;
                text: (Live.plot-view == "top" ? "TOP VIEW" : Live.plot-view == "front" ? "FRONT VIEW" : "ISO VIEW") + (Live.plot-summary == "" ? "" : " · " + Live.plot-summary);
                font-family: Theme.body; font-size: 16px; color: Theme.dim;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Seg { width: 90px; text: "ISO"; on: Live.plot-view == "iso"; clicked => { Actions.plot-view("iso"); } }
            Seg { width: 90px; text: "TOP"; on: Live.plot-view == "top"; clicked => { Actions.plot-view("top"); } }
            Seg { width: 110px; text: "FRONT"; on: Live.plot-view == "front"; clicked => { Actions.plot-view("front"); } }
            Rectangle { horizontal-stretch: 1; }
            Btn { width: 170px; text: "CLEAR TRAIL"; clicked => { Actions.plot-clear-trail(); } }
        }
    }
}

component GcodeView inherits VerticalLayout {
    spacing: 10px;
    property <length> line-h: 32px;
    property <int> cur: Live.line - 1;
    property <int> picked: Live.gcode-selected;
    // Keep the executing (or found) line in view, a third of the way down.
    changed cur => { if Live.running { list.content-y = -max(0px, (cur - 6) * line-h); } }
    changed picked => { if picked >= 0 { list.content-y = -max(0px, (picked - 6) * line-h); } }
    Rectangle {
        vertical-stretch: 1;
        background: Theme.well;
        border-radius: 6px;
        list := ListView {
            for code[i] in Live.gcode-lines: GLine {
                n: i + 1;
                code: code;
                current: i == cur;
                picked: i == Live.gcode-selected;
                tapped => { Live.gcode-selected = i; }
            }
        }
        if Live.gcode-count == 0: Note { horizontal-alignment: center; vertical-alignment: center; text: "Load a program on FILES."; }
    }
    HorizontalLayout {
        spacing: 12px;
        Btn { text: "RUN FROM SELECTED"; enabled: false; sub: "NOT YET"; }
        Btn { text: "NEXT M6"; enabled: Live.gcode-count > 0; clicked => { Actions.gcode-next-m6(); } }
    }
}

component RunTabs inherits HorizontalLayout {
    spacing: 0px;
    Seg { text: "G-CODE"; on: Live.run-tab == "program"; clicked => { Live.run-tab = "program"; } }
    Seg { text: "MDI"; on: Live.run-tab == "mdi"; clicked => { Live.run-tab = "mdi"; } }
    Seg { text: "JOG"; on: Live.run-tab == "jog"; clicked => { Live.run-tab = "jog"; } }
}

export component RunScreen inherits Rectangle {
    // The right panel keeps one width for every tab (the JOG tab's), so the
    // backplot never moves or resizes when switching tabs.
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        ProgramCard { horizontal-stretch: 1; }
        Card {
            width: 545px;
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                RunTabs { }
                if Live.run-tab == "program": GcodeView { vertical-stretch: 1; }
                if Live.run-tab == "mdi": MdiPanel { vertical-stretch: 1; }
                if Live.run-tab == "jog": JogPanel { vertical-stretch: 1; }
            }
        }
    }
}
