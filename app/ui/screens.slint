import { Theme } from "theme.slint";
import { Live, Actions, MdiCard } from "state.slint";
import { Card, Label, Btn, Seg, Note } from "widgets.slint";

// Placeholder for screens that later milestones fill in.
export component Placeholder inherits Rectangle {
    in property <string> title;
    in property <string> note;
    Card {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                horizontal-alignment: center;
                text: title;
                font-family: Theme.display;
                font-size: 48px;
                letter-spacing: 2px;
                color: Theme.ink;
            }
            Text {
                horizontal-alignment: center;
                text: note;
                font-family: Theme.body;
                font-size: 24px;
                color: Theme.muted;
            }
        }
    }
}

component KeyBtn inherits Btn {
    height: 66px;
    font-size: self.text == "SPACE" || self.text == "CLR" ? 22px : 30px;
    enabled: Live.power && !Live.manual-locked;
    clicked => { Actions.mdi-key(self.text); }
}

// MDI (mockup v17): command line, help, library by category, G-code keypad.
component MdiPanel inherits VerticalLayout {
    spacing: 12px;
    property <bool> unlocked: Live.power && !Live.manual-locked;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            horizontal-stretch: 1;
            height: 72px;
            background: Theme.well;
            border-width: 1px;
            border-color: input.has-focus ? Theme.sel : Theme.line;
            border-radius: 6px;
            input := TextInput {
                x: 16px;
                width: parent.width - 32px;
                vertical-alignment: center;
                text <=> Live.mdi-text;
                font-family: Theme.display;
                font-size: 36px;
                letter-spacing: 1px;
                color: Theme.ink;
                enabled: unlocked;
                edited => { Actions.mdi-edited(); }
                accepted => { Actions.mdi-send(self.text); }
            }
        }
        Btn {
            width: 200px;
            height: 72px;
            text: "SEND";
            kind: "go";
            font-size: 28px;
            enabled: unlocked && Live.mdi-text != "";
            clicked => { Actions.mdi-send(Live.mdi-text); }
        }
    }
    Text {
        height: 28px;
        overflow: elide;
        text: Live.manual-locked ? "MDI is locked while a program runs or is paused." : Live.mdi-help;
        font-family: Theme.body;
        font-size: 21px;
        color: Theme.muted;
    }
    HorizontalLayout {
        spacing: 14px;
        VerticalLayout {
            width: 170px;
            spacing: 10px;
            alignment: start;
            for c in Live.mdi-categories: Btn {
                height: 64px;
                text: c;
                font-size: 22px;
                on: Live.mdi-category == c;
                clicked => { Actions.mdi-category-set(c); }
            }
        }
        Flickable {
            horizontal-stretch: 1;
            content-height: grid.preferred-height;
            grid := VerticalLayout {
                spacing: 10px;
                alignment: start;
                for row in (Live.mdi-cards.length + 1) / 2: HorizontalLayout {
                    spacing: 10px;
                    for col in 2: Rectangle {
                        property <int> i: row * 2 + col;
                        property <MdiCard> card: Live.mdi-cards[i];
                        horizontal-stretch: 1;
                        height: 76px;
                        border-radius: 6px;
                        background: i >= Live.mdi-cards.length ? transparent : ct.pressed && unlocked ? Theme.sel : Theme.raised;
                        border-width: i >= Live.mdi-cards.length ? 0 : 1px;
                        border-color: Theme.raised-border;
                        opacity: unlocked ? 1 : 0.38;
                        if i < Live.mdi-cards.length: VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: card.label; font-family: Theme.display; font-size: 28px; letter-spacing: 1px; color: Theme.ink; overflow: elide; }
                                if card.moves: Text { vertical-alignment: center; text: "· MOVES"; font-family: Theme.display; font-size: 18px; color: #f2c14e; }
                            }
                            if card.desc != "": Text { text: card.desc; font-family: Theme.body; font-size: 18px; color: Theme.muted; overflow: elide; }
                        }
                        ct := TouchArea {
                            enabled: unlocked && i < Live.mdi-cards.length;
                            clicked => { Actions.mdi-pick(card.fill); }
                        }
                    }
                }
                if Live.mdi-cards.length == 0: Note { text: Live.mdi-category == "RECENT" ? "Commands you send appear here." : "No entries in this category."; }
            }
        }
        VerticalLayout {
            width: 400px;
            spacing: 10px;
            alignment: start;
            Label { text: "KEYPAD"; }
            GridLayout {
                spacing: 8px;
                Row { for k in ["G", "M", "X", "Y", "Z"]: KeyBtn { text: k; } }
                Row { for k in ["A", "F", "S", "T", "H"]: KeyBtn { text: k; } }
                Row { for k in ["P", "Q", "L", "R", "."]: KeyBtn { text: k; } }
                Row { for k in ["7", "8", "9", "−", "⌫"]: KeyBtn { text: k; } }
                Row { for k in ["4", "5", "6", "SPACE", "CLR"]: KeyBtn { text: k; } }
                Row { for k in ["1", "2", "3", "0"]: KeyBtn { text: k; } }
            }
        }
    }
}

export component RunScreen inherits Rectangle {
    VerticalLayout {
        padding: 14px;
        spacing: 14px;
        HorizontalLayout {
            Seg { text: "G-CODE"; on: Live.run-tab == "program"; clicked => { Live.run-tab = "program"; } }
            Seg { text: "MDI"; on: Live.run-tab == "mdi"; clicked => { Live.run-tab = "mdi"; } }
        }
        Rectangle {
            vertical-stretch: 1;
            if Live.run-tab == "program": Placeholder {
                width: parent.width + 28px;
                x: -14px; y: -14px;
                height: parent.height + 28px;
                title: Live.program == "" ? "NO PROGRAM LOADED" : Live.program;
                note: (Live.program == "" ? "" : "LINE " + Live.line + " · ") + "G-code view and preview arrive in milestone 3";
            }
            if Live.run-tab == "mdi": MdiPanel { }
        }
    }
}
