import { Theme, Layout } from "theme.slint";
import { Live, Actions, PillData, DroRow, DroPos, NavItem, MsgRow, MdiCard, GotoRow, FileRow, ToolRow, CheckRow, OffsetRow, ProbeItem, ProbeSpot, ProbeParam, WarmStage, StatusRow, JobOp, ConvField, HistoryRow, SetupRow, SetupStep } from "state.slint";
import { StatusBar, LeftColumn, BottomBar } from "frame.slint";
import { Placeholder, RunScreen, Blocked } from "screens.slint";
import { Arrive, Caption } from "widgets.slint";
import { Brand, Boot, BootStep, Splash } from "brand.slint";

import { ManualScreen } from "jog.slint";
import { FilesScreen } from "files.slint";
import { ToolsScreen } from "tools.slint";
import { OffsetsScreen } from "offsets.slint";
import { ProbeScreen } from "probe.slint";
import { UtilScreen } from "util.slint";
import { Keypad, TextKeyboard, MessageDrawer, ToolChange, Picker } from "overlays.slint";
import { JobScreen } from "job.slint";
import { ConvScreen } from "conv.slint";
import { SetupScreen } from "setup.slint";

export { Live, Actions, PillData, DroRow, DroPos, NavItem, MsgRow, MdiCard, GotoRow, FileRow, ToolRow, CheckRow, OffsetRow, ProbeItem, ProbeSpot, ProbeParam, WarmStage, StatusRow, JobOp, ConvField, HistoryRow, SetupRow, SetupStep }
export { Brand, Boot, BootStep }

// Drawn at the mill's 1920x1080. Each screen is only instantiated while it
// is shown, so a disabled module's screen never exists.
export component MainWindow inherits Window {
    title: Brand.title;
    // Fixed on the touchscreen; desktop and browser windows scale or stretch it.
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: Theme.frame;
    default-font-family: Theme.body;
    init => { Layout.width = self.width; }
    changed width => { Layout.width = self.width; }

    StatusBar { x: 0; y: 0; width: parent.width; height: 64px; }
    LeftColumn { x: 0; y: 64px; width: Layout.left; height: parent.height - 64px - 128px; }
    Rectangle {
        x: Layout.left;
        y: 64px;
        width: parent.width - Layout.left;
        height: parent.height - 64px - 128px;
        // A screen fades in and rises 12px as it opens: a one-off, so the
        // eye follows the change without the screen moving at idle.
        if Live.screen == "run": Arrive { RunScreen {} }
        if Live.screen == "job" && Live.job-blocked == "": Arrive { JobScreen {} }
        if Live.screen == "manual": Arrive { ManualScreen {} }
        if Live.screen == "probe" && Live.probe-blocked == "": Arrive { ProbeScreen {} }
        if Live.screen == "tools": Arrive { ToolsScreen {} }
        if Live.screen == "offsets": Arrive { OffsetsScreen {} }
        if Live.screen == "conv" && Live.conv-blocked == "": Arrive { ConvScreen {} }
        if Live.screen == "probe" && Live.probe-blocked != "": Arrive { Blocked { title: "PROBE"; text: Live.probe-blocked; } }
        if Live.screen == "job" && Live.job-blocked != "": Arrive { Blocked { title: "JOB"; text: Live.job-blocked; } }
        if Live.screen == "conv" && Live.conv-blocked != "": Arrive { Blocked { title: "CONV"; text: Live.conv-blocked; } }
        if Live.screen == "files": Arrive { FilesScreen {} }
        if Live.screen == "util": Arrive { UtilScreen {} }
        if Live.screen == "setup": Arrive { SetupScreen {} }
        if Live.drawer-open: MessageDrawer {}
        if Live.tc-open: ToolChange {}
        if Live.pick-open: Picker {}
        if Live.keypad-open: Keypad {}
        if Live.text-open: TextKeyboard {}
    }
    BottomBar { x: 0; y: parent.height - 128px; width: parent.width; height: 128px; }
    // The status list under its pill; a tap anywhere closes it.
    if Live.status-open: TouchArea { clicked => { Live.status-open = false; } }
    // It unfolds down from the pill (Theme.enter) and closes at once.
    if Live.status-open: Rectangle {
        // `unfold` goes 0 to 1 once (init); the height follows the rows.
        property <float> unfold: 0;
        init => { self.unfold = 1; }
        animate unfold { duration: Theme.enter; easing: ease-out; }
        x: min(Live.status-x * 1px, parent.width - self.width - 14px);
        y: 60px;
        width: 440px;
        height: 38px + (rows.preferred-height - 38px) * unfold;
        opacity: min(1, 2 * unfold);
        clip: true;
        background: Theme.panel2;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius-ctl;
        rows := VerticalLayout {
            // Laid out at full height while the panel unfolds over it.
            height: self.preferred-height;
            y: 0;
            padding: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 0px;
            Caption { height: 38px; vertical-alignment: center; text: "MACHINE STATUS"; }
            for p in Live.pills: HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    padding-top: 18px;
                    alignment: start;
                    Rectangle {
                        width: 11px;
                        height: 11px;
                        border-radius: 5.5px;
                        background: p.kind == "good" ? Theme.good : p.kind == "warn" ? Theme.warn : p.kind == "bad" ? Theme.bad : p.kind == "info" ? Theme.info : Theme.dim;
                    }
                }
                VerticalLayout {
                    padding-top: 9px;
                    padding-bottom: 9px;
                    spacing: 2px;
                    Text {
                        height: 30px;
                        vertical-alignment: center;
                        text: p.text;
                        font-family: Theme.display;
                        font-size: Theme.t-ctl;
                        letter-spacing: 1.2px;
                        color: p.kind == "bad" ? Theme.bad : p.kind == "warn" ? Theme.warn : Theme.ink;
                    }
                    if p.hint != "": Text {
                        text: p.hint;
                        wrap: word-wrap;
                        font-family: Theme.body;
                        font-size: Theme.t-body;
                        color: Theme.muted;
                    }
                }
            }
        }
        TouchArea { clicked => { Live.status-open = false; } }
    }
    // The toast takes the top bar's message area (it says the same thing,
    // louder), so it never covers a control on the screen below. It drops
    // into place as it appears; a long one grows down over the screen's edge.
    if Live.toast != "": Rectangle {
        property <length> right: Live.remote ? 290px : 400px;
        width: min(640px, parent.width - Layout.left - self.right - 20px);
        x: parent.width - self.right - self.width;
        y: -8px;
        opacity: 0;
        init => {
            self.y = 4px;
            self.opacity = 1;
        }
        animate y, opacity { duration: Theme.enter; easing: ease-out; }
        // Grows to fit: an error is read in full, never cut off.
        height: max(56px, toast-text.preferred-height + 16px);
        background: Theme.panel2;
        border-width: 2px;
        border-color: Live.toast-info ? Theme.warn : Theme.bad;
        border-radius: Theme.radius-ctl;
        toast-text := Text {
            x: 18px;
            width: parent.width - 36px;
            height: parent.height;
            vertical-alignment: center;
            text: Live.toast;
            wrap: word-wrap;
            font-family: Theme.body;
            font-weight: 600;
            font-size: Theme.t-ctl;
            color: Live.toast-info ? Theme.warn : Theme.bad;
        }
        TouchArea { clicked => { Live.toast = ""; Actions.toast-dismiss(); } }
    }
    // The start-up splash, over everything until ferrum is connected.
    if Boot.phase != "": Splash { x: 0; y: 0; width: parent.width; height: parent.height; }
}
