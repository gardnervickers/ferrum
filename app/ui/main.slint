import { Theme } from "theme.slint";
import { Live, Actions, PillData, DroRow, NavItem } from "state.slint";
import { StatusBar, LeftColumn, BottomBar } from "frame.slint";
import { Placeholder, RunScreen } from "screens.slint";

export { Live, Actions, PillData, DroRow, NavItem }

// Drawn at the mill's 1920x1080. Each screen is only instantiated while it
// is shown, so a disabled module's screen never exists.
export component MainWindow inherits Window {
    title: "millgui";
    width: 1920px;
    height: 1080px;
    background: Theme.frame;
    default-font-family: Theme.body;

    StatusBar { x: 0; y: 0; width: parent.width; height: 64px; }
    LeftColumn { x: 0; y: 64px; width: 520px; height: parent.height - 64px - 128px; }
    Rectangle {
        x: 520px;
        y: 64px;
        width: parent.width - 520px;
        height: parent.height - 64px - 128px;
        if Live.screen == "run": RunScreen {}
        if Live.screen == "job": Placeholder { title: "JOB"; note: "Milestone 6"; }
        if Live.screen == "jog": Placeholder { title: "JOG"; note: "Milestone 2"; }
        if Live.screen == "probe": Placeholder { title: "PROBE"; note: "Milestone 5"; }
        if Live.screen == "tools": Placeholder { title: "TOOLS"; note: "Milestone 4"; }
        if Live.screen == "offsets": Placeholder { title: "OFFSETS"; note: "Milestone 4"; }
        if Live.screen == "conv": Placeholder { title: "CONVERSATIONAL"; note: "Milestone 6"; }
        if Live.screen == "files": Placeholder { title: "FILES"; note: "Milestone 3"; }
        if Live.screen == "util": Placeholder { title: "UTIL"; note: "Milestone 5"; }
    }
    BottomBar { x: 0; y: parent.height - 128px; width: parent.width; height: 128px; }
}
