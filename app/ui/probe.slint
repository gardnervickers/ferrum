import { Theme } from "theme.slint";
import { Live, Actions, ProbeItem, ProbeSpot, ProbeParam } from "state.slint";
import { Btn, Seg, Card, Label, H3, Note, Pill } from "widgets.slint";

// One run value: label (with unit), reset chip when changed, − value +.
// The chip's slot is always reserved so changing a value moves nothing.
component Stepper inherits Rectangle {
    in property <ProbeParam> p;
    in property <bool> enabled: true;
    background: p.changed ? #43361a : Theme.panel2;
    border-radius: 6px;
    min-width: 170px;
    // Equal columns whatever the label length.
    preferred-width: 170px;
    horizontal-stretch: 1;
    height: 104px;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            Label { horizontal-stretch: 1; vertical-alignment: center; text: p.unit != "" ? p.label + "  " + p.unit : p.label; font-size: 18px; overflow: elide; color: p.changed ? #f3c463 : Theme.muted; }
            // Only the label elides when the chip shows; the stepper keeps its size.
            Rectangle {
                width: p.changed ? 64px : 0px;
                border-radius: 14px;
                background: !p.changed ? transparent : rt.pressed ? Theme.raised : Theme.well;
                if p.changed: Text { text: "RESET"; font-family: Theme.body; font-size: 16px; color: Theme.muted; overflow: elide; }
                rt := TouchArea { enabled: p.changed; clicked => { Actions.probe-reset(p.id); } }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Btn { width: 46px; height: 54px; text: "−"; font-size: 30px; enabled: root.enabled; clicked => { Actions.probe-step(p.id, -1); } }
            Rectangle {
                horizontal-stretch: 1;
                height: 54px;
                background: Theme.well;
                border-radius: 6px;
                border-width: 1px;
                border-color: vt.pressed ? Theme.sel : Theme.line;
                Text { x: 6px; width: parent.width - 12px; horizontal-alignment: center; vertical-alignment: center; text: p.value; font-family: Theme.body; font-weight: 600; font-size: 26px; color: Theme.ink; overflow: elide; }
                vt := TouchArea { enabled: root.enabled; clicked => { Actions.edit("prun-" + p.id); } }
            }
            Btn { width: 46px; height: 54px; text: "+"; font-size: 30px; enabled: root.enabled; clicked => { Actions.probe-step(p.id, 1); } }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> dw: 1300px;
    in property <length> dh: 760px;
    callback close();
    background: #000000a0;
    TouchArea {}
    Rectangle {
        x: (parent.width - root.dw) / 2;
        y: (parent.height - root.dh) / 2;
        width: root.dw;
        height: root.dh;
        background: Theme.panel;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.raised-border;
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                height: 64px;
                H3 { horizontal-stretch: 1; vertical-alignment: center; text: root.title; }
                Btn { width: 200px; height: 64px; kind: "go"; text: "DONE"; clicked => { root.close(); } }
            }
            @children
        }
    }
}

export component ProbeScreen inherits Rectangle {
    property <bool> locked: Live.manual-locked;
    property <bool> more-open;
    property <bool> defaults-open;
    property <string> defaults-tab: "probe";
    property <bool> wcs-open;
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        // Mode and shape
        Card {
            width: 290px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    Seg { horizontal-stretch: 1; text: "FIND"; font-size: 21px; on: Live.pr-mode == "find"; clicked => { Actions.probe-mode("find"); } }
                    Seg { horizontal-stretch: 1; text: "MEASURE"; font-size: 21px; on: Live.pr-mode == "meas"; clicked => { Actions.probe-mode("meas"); } }
                    Seg { horizontal-stretch: 1; text: "CAL"; font-size: 21px; on: Live.pr-mode == "cal"; clicked => { Actions.probe-mode("cal"); } }
                }
                Label { height: 26px; text: Live.pr-shape-label; overflow: elide; }
                for s in Live.pr-shapes: Btn { height: 66px; text: s.label; on: s.on; clicked => { Actions.probe-shape(s.id); } }
                Rectangle { vertical-stretch: 1; }
                Note { text: Live.pr-routine; }
            }
        }
        // Target picture, values, run
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    H3 { horizontal-stretch: 1; text: Live.pr-title; overflow: elide; }
                    Pill { text: Live.pr-pill; kind: Live.pr-pill-kind; }
                }
                pic := Rectangle {
                    vertical-stretch: 1;
                    min-height: 260px;
                    background: Theme.well;
                    border-radius: 6px;
                    clip: true;
                    property <float> sc: min(self.width / 400px, (self.height - 24px) / 300px);
                    property <length> ox: (self.width - 400px * sc) / 2;
                    property <length> oy: 24px + (self.height - 24px - 300px * sc) / 2;
                    Label { x: 0; y: 4px; width: parent.width; horizontal-alignment: center; text: Live.pr-hint; }
                    Path {
                        // The browser build redraws a changed Path over open overlays.
                        visible: !(Live.tc-open || Live.pick-open || Live.keypad-open || Live.drawer-open || root.more-open || root.defaults-open || root.wcs-open);
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-outline;
                        stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                    }
                    Path {
                        // The browser build redraws a changed Path over open overlays.
                        visible: !(Live.tc-open || Live.pick-open || Live.keypad-open || Live.drawer-open || root.more-open || root.defaults-open || root.wcs-open);
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-arrows;
                        stroke: #f3c46380; stroke-width: 2px; fill: transparent;
                    }
                    Path {
                        // The browser build redraws a changed Path over open overlays.
                        visible: !(Live.tc-open || Live.pick-open || Live.keypad-open || Live.drawer-open || root.more-open || root.defaults-open || root.wcs-open);
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-heads;
                        fill: #f3c463; stroke: transparent;
                    }
                    for sp in Live.pr-spots: Rectangle {
                        property <bool> pill: sp.label != "";
                        property <bool> edge: sp.w > 0 && !pill;
                        x: pic.ox + (pill ? (sp.x - sp.w / 2) : edge ? sp.x : (sp.x - sp.r)) * pic.sc * 1px;
                        y: pic.oy + (pill ? (sp.y - sp.h / 2) : edge ? sp.y : (sp.y - sp.r)) * pic.sc * 1px;
                        width: (pill || edge ? sp.w : 2 * sp.r) * pic.sc * 1px;
                        height: (pill || edge ? sp.h : 2 * sp.r) * pic.sc * 1px;
                        border-radius: (edge ? 6 : pill ? sp.h / 2 : sp.r) * pic.sc * 1px;
                        background: pill ? (sp.on ? #f3c463 : Theme.panel2) : sp.on ? #f3c4638c : #6d7cff4d;
                        border-width: 2px;
                        border-color: sp.on ? #f3c463 : pill ? #5a6268 : #6d7cff;
                        if pill: Text {
                            text: sp.label;
                            font-family: Theme.display;
                            font-size: 15px * pic.sc * 1.3;
                            color: sp.on ? #0f1214 : Theme.muted;
                        }
                        TouchArea { clicked => { Actions.probe-target(sp.id); } }
                    }
                }
                if Live.pr-opts.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for o in Live.pr-opts: Btn { min-width: 150px; height: 54px; font-size: 20px; text: o.label; on: o.on; clicked => { Actions.probe-opt(o.id); } }
                }
                // Fixed slots: the side buttons are always there (disabled
                // when they don't apply) so taps never land somewhere else.
                HorizontalLayout {
                    spacing: 10px;
                    GridLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        for p[i] in Live.pr-params: Stepper {
                            col: mod(i, Live.pr-params.length > 3 ? 2 : 3);
                            row: floor(i / (Live.pr-params.length > 3 ? 2 : 3));
                            p: p;
                            enabled: !Live.pr-running;
                        }
                    }
                    VerticalLayout {
                        width: 140px;
                        spacing: 6px;
                        alignment: start;
                        Btn { height: 44px; font-size: 19px; text: Live.pr-more.length > 0 ? "MORE · " + Live.pr-more.length : "MORE"; enabled: Live.pr-more.length > 0; clicked => { root.more-open = true; } }
                        Btn { height: 44px; font-size: 19px; text: "RESET ALL"; enabled: Live.pr-changed; clicked => { Actions.probe-reset-all(); } }
                        Btn { height: 44px; font-size: 19px; text: "DEFAULTS"; clicked => { root.defaults-open = true; } }
                    }
                }
                // One status line, always the same height.
                Text {
                    height: 52px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    font-family: Theme.body;
                    font-size: 19px;
                    overflow: elide;
                    color: Live.pr-running || Live.pr-ready != "" ? #f3c463 : Theme.muted;
                    text: Live.pr-running ? "RUNNING…" : Live.pr-ready != "" ? Live.pr-ready : Live.pr-note;
                }
                HorizontalLayout {
                    spacing: 14px;
                    Btn { width: 230px; text: Live.pr-load-label; enabled: Live.pr-load-enabled && !locked && Live.power && !Live.pr-running; clicked => { Actions.probe-load(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Btn { width: 160px; kind: "stop"; text: "STOP"; clicked => { Actions.probe-stop(); } }
                    Btn { width: 270px; kind: "go"; hold: true; text: Live.pr-run-label; enabled: Live.pr-ready == "" && !locked; clicked => { Actions.probe-run(); } }
                }
            }
        }
        // Write to and result
        Card {
            width: 290px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                if Live.pr-show-wcs: Label { text: "WRITE TO"; }
                if Live.pr-show-wcs: Btn { text: Live.pr-wcs + "  ▾"; font-size: 30px; enabled: !Live.pr-running; clicked => { root.wcs-open = true; } }
                H3 { text: "RESULT"; }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.well;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 12px;
                        Text { text: Live.pr-result; font-family: Theme.body; font-size: 24px; color: Theme.ink; wrap: word-wrap; vertical-alignment: top; }
                    }
                }
            }
        }
    }
    if more-open: Dialog {
        title: "MORE SETTINGS · THIS RUN ONLY";
        dw: 1300px;
        // Sized to the rows so no empty band is left below them.
        dh: min(900px, 140px + ceil(Live.pr-more.length / 3) * 114px);
        close => { root.more-open = false; }
        Note { text: "Changed values show in amber and go back to the default after the run. Defaults live under DEFAULTS."; }
        GridLayout {
            spacing: 10px;
            for p[i] in Live.pr-more: Stepper { col: mod(i, 3); row: floor(i / 3); p: p; enabled: !Live.pr-running; }
        }
        Rectangle { vertical-stretch: 1; }
    }
    if defaults-open: Dialog {
        title: "PROBE DEFAULTS";
        dw: 1300px;
        dh: 840px;
        close => { root.defaults-open = false; }
        HorizontalLayout {
            height: 60px;
            spacing: 0;
            Seg { horizontal-stretch: 1; text: "TOUCH PROBE"; on: root.defaults-tab == "probe"; clicked => { root.defaults-tab = "probe"; } }
            Seg { horizontal-stretch: 1; text: "TOOL SETTER"; on: root.defaults-tab == "setter"; clicked => { root.defaults-tab = "setter"; } }
            Seg { horizontal-stretch: 1; text: "CALIBRATION"; on: root.defaults-tab == "cal"; clicked => { root.defaults-tab = "cal"; } }
        }
        Note { height: 28px; text: "Saved values (#3004–#3037). Tap one to change it; it is written to LinuxCNC now."; }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.well;
            border-radius: 6px;
            clip: true;
            Flickable {
                content-height: dlist.preferred-height;
                dlist := VerticalLayout {
                    padding: 8px;
                    for p in Live.pr-defaults: Rectangle {
                        visible: p.def == root.defaults-tab;
                        height: p.def == root.defaults-tab ? 66px : 0px;
                        Rectangle {
                            y: 3px;
                            height: parent.height - 6px;
                            background: dt.pressed ? Theme.raised : Theme.panel2;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;
                                Label { width: 90px; vertical-alignment: center; text: "#" + p.id; color: Theme.dim; }
                                Label { horizontal-stretch: 1; vertical-alignment: center; text: p.label; font-size: 22px; color: Theme.ink; overflow: elide; }
                                Text { width: 260px; horizontal-alignment: right; vertical-alignment: center; text: p.value + (p.unit != "" ? " " + p.unit : ""); font-family: Theme.body; font-weight: 600; font-size: 26px; color: Theme.ink; overflow: elide; }
                            }
                            dt := TouchArea { clicked => { Actions.edit("pdef-" + p.id); } }
                        }
                    }
                }
            }
        }
    }
    if wcs-open: Dialog {
        title: "WRITE TO";
        dw: 520px;
        dh: 860px;
        close => { root.wcs-open = false; }
        for c in Live.wcs-codes: Btn {
            height: 66px;
            font-size: 30px;
            text: c;
            on: c == Live.pr-wcs;
            clicked => { Actions.probe-wcs(c); root.wcs-open = false; }
        }
    }
}
