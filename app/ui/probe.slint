import { Theme, Layout } from "theme.slint";
import { Live, Actions, ProbeItem, ProbeOpt, ProbeSpot, ProbeParam } from "state.slint";
import { Btn, Seg, Card, Label, H3, Note, Pill } from "widgets.slint";

// One run value: label (with unit, and the default once changed), then
// − value + and a RESET button that only shows when the value differs from
// the default. Its slot is always reserved, so changing a value moves nothing.
component Stepper inherits Rectangle {
    in property <ProbeParam> p;
    in property <bool> enabled: true;
    background: p.changed ? Theme.warn-soft : Theme.panel2;
    animate background { duration: Theme.settle; }
    border-radius: Theme.radius-ctl;
    min-width: 300px;
    horizontal-stretch: 1;
    height: 106px;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Label {
            height: 26px;
            vertical-alignment: center;
            text: (p.unit != "" ? p.label + "  " + p.unit : p.label) + (p.changed ? "   ·   DEFAULT " + p.def : "");
            font-size: 20px;
            overflow: elide;
            color: p.changed ? Theme.warn : Theme.muted;
        }
        HorizontalLayout {
            height: 58px;
            spacing: 6px;
            Btn { width: 64px; text: "−"; font-size: 30px; enabled: root.enabled; clicked => { Actions.probe-step(p.id, -1); } }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.well;
                border-radius: Theme.radius-ctl;
                border-width: 1px;
                border-color: vt.pressed ? Theme.sel : Theme.line;
                Text { x: 6px; width: parent.width - 12px; horizontal-alignment: center; vertical-alignment: center; text: p.value; font-family: Theme.body; font-weight: 600; font-size: 28px; color: Theme.ink; overflow: elide; }
                vt := TouchArea { enabled: root.enabled; clicked => { Actions.edit("prun-" + p.id); } }
            }
            Btn { width: 64px; text: "+"; font-size: 30px; enabled: root.enabled; clicked => { Actions.probe-step(p.id, 1); } }
            Rectangle {
                width: 96px;
                if p.changed: Btn { width: parent.width; height: parent.height; text: "RESET"; font-size: 20px; enabled: root.enabled; clicked => { Actions.probe-reset(p.id); } }
            }
        }
    }
}

// A labelled row of choices under the picture. The label is plain text; the
// choices are buttons. An empty row keeps its height.
component OptRow inherits HorizontalLayout {
    in property <string> label;
    in property <[ProbeOpt]> opts;
    in property <bool> enabled: true;
    height: 60px;
    spacing: 8px;
    alignment: start;
    Label { width: 110px; vertical-alignment: center; text: root.label; overflow: elide; }
    for o in root.opts: Btn {
        min-width: 104px;
        height: 60px;
        font-size: 21px;
        text: o.label;
        on: o.on;
        enabled: o.enabled && root.enabled;
        clicked => { Actions.probe-opt(o.id); }
    }
}

// Small step heading ("1 · WHAT"): plain text, never a control.
component Step inherits Text {
    font-family: Theme.display;
    font-size: 20px;
    letter-spacing: 1.6px;
    color: Theme.dim;
    vertical-alignment: center;
    height: 26px;
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> dw: 1300px;
    in property <length> dh: 760px;
    callback close();
    background: Theme.scrim;
    TouchArea {}
    Rectangle {
        x: (parent.width - root.dw) / 2;
        y: (parent.height - root.dh) / 2;
        width: root.dw;
        height: root.dh;
        background: Theme.panel;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.raised-border;
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                height: 64px;
                H3 { horizontal-stretch: 1; vertical-alignment: center; text: root.title; }
                Btn { width: 200px; height: 64px; text: "DONE"; clicked => { root.close(); } }
            }
            @children
        }
    }
}

export component ProbeScreen inherits Rectangle {
    property <bool> locked: Live.manual-locked;
    property <bool> more-open;
    property <bool> defaults-open;
    property <string> defaults-tab: "probe";
    property <bool> wcs-open;
    // The browser build redraws a changed Path over open overlays.
    property <bool> paths-visible: !(Live.tc-open || Live.pick-open || Live.keypad-open || Live.drawer-open || root.more-open || root.defaults-open || root.wcs-open);
    // Every slot below has a fixed size: changing the mode, shape or target
    // changes what is in a slot, never where anything is.
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        // 1 · What: mode and shape
        Card {
            width: Layout.compact ? 250px : 290px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Step { text: "1 · WHAT"; }
                HorizontalLayout {
                    height: 60px;
                    Seg { horizontal-stretch: 1; text: "FIND"; font-size: 21px; on: Live.pr-mode == "find"; enabled: !Live.pr-running; clicked => { Actions.probe-mode("find"); } }
                    Seg { horizontal-stretch: 1; text: "MEASURE"; font-size: 21px; on: Live.pr-mode == "meas"; enabled: !Live.pr-running; clicked => { Actions.probe-mode("meas"); } }
                    Seg { horizontal-stretch: 1; text: "CAL"; font-size: 21px; on: Live.pr-mode == "cal"; enabled: !Live.pr-running; clicked => { Actions.probe-mode("cal"); } }
                }
                Label { height: 26px; text: Live.pr-shape-label; overflow: elide; }
                for s in Live.pr-shapes: Btn { height: 66px; text: s.label; on: s.on; enabled: !Live.pr-running; clicked => { Actions.probe-shape(s.id); } }
                Rectangle { vertical-stretch: 1; }
                // Two lines' room, top-aligned: a shorter routine name must
                // not drop the text.
                Note { height: 48px; vertical-alignment: top; font-size: 18px; text: Live.pr-routine; }
            }
        }
        // 2 · Where: the picture (its spots are the only controls on it),
        // the choices for the target, and the result.
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    height: 40px;
                    spacing: 14px;
                    Step { height: 40px; text: "2 · WHERE"; }
                    H3 { horizontal-stretch: 1; vertical-alignment: center; text: Live.pr-title; overflow: elide; }
                }
                pic := Rectangle {
                    vertical-stretch: 1;
                    min-height: 300px;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    // A band above for the hint and one below for the preview's caption.
                    property <float> sc: min(self.width / 400px, (self.height - 64px) / 300px);
                    property <length> ox: (self.width - 400px * sc) / 2;
                    property <length> oy: 32px + (self.height - 64px - 300px * sc) / 2;
                    Text { x: 0; y: 6px; width: parent.width; horizontal-alignment: center; text: Live.pr-hint; font-family: Theme.body; font-size: 19px; color: Theme.dim; }
                    Path {
                        visible: root.paths-visible;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-outline;
                        stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                    }
                    // The part on the rotary, turning with A in the preview.
                    Path {
                        visible: root.paths-visible;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-part;
                        stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                    }
                    for sp in Live.pr-spots: Rectangle {
                        property <bool> edge: sp.w > 0;
                        x: pic.ox + (edge ? sp.x : (sp.x - sp.r)) * pic.sc * 1px;
                        y: pic.oy + (edge ? sp.y : (sp.y - sp.r)) * pic.sc * 1px;
                        width: (edge ? sp.w : 2 * sp.r) * pic.sc * 1px;
                        height: (edge ? sp.h : 2 * sp.r) * pic.sc * 1px;
                        border-radius: (edge ? 8 : sp.r) * pic.sc * 1px;
                        background: sp.on ? Theme.warn.with-alpha(0.4) : st.pressed ? Theme.sel.with-alpha(0.5) : Theme.sel-soft;
                        border-width: 3px;
                        border-color: sp.on ? Theme.warn : Theme.sel;
                        animate background, border-color { duration: Theme.quick; }
                        st := TouchArea { enabled: !Live.pr-running; clicked => { Actions.probe-target(sp.id); } }
                    }
                    // Approach moves, drawn over the spots (not tappable).
                    Path {
                        visible: root.paths-visible;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-arrows;
                        stroke: Theme.warn.with-alpha(0.75); stroke-width: 2px; fill: transparent;
                    }
                    Path {
                        visible: root.paths-visible;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-heads;
                        fill: Theme.warn; stroke: transparent;
                    }
                    // The preview: the tip plays the routine in a loop.
                    // Green is the preview; amber stays the approach arrows.
                    Path {
                        visible: root.paths-visible && Live.pr-tip-on;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-trail;
                        stroke: Theme.good.with-alpha(0.8); stroke-width: 3px; fill: transparent;
                    }
                    if Live.pr-tip-on: Rectangle {
                        // Clear of the part the tip is drawn larger and fainter.
                        property <length> r: (6 + 5 * Live.pr-tip-z) * pic.sc * 1px;
                        visible: root.paths-visible;
                        x: pic.ox + Live.pr-tip-x * pic.sc * 1px - self.r;
                        y: pic.oy + Live.pr-tip-y * pic.sc * 1px - self.r;
                        width: 2 * self.r; height: 2 * self.r;
                        border-radius: self.r;
                        background: Theme.good.with-alpha(0.9 - 0.55 * Live.pr-tip-z);
                        border-width: 2px;
                        border-color: Theme.good;
                        // The touch.
                        Rectangle {
                            visible: Live.pr-tip-contact;
                            x: -parent.r * 0.8; y: -parent.r * 0.8;
                            width: 3.6 * parent.r; height: 3.6 * parent.r;
                            border-radius: 1.8 * parent.r;
                            border-width: 2px;
                            border-color: Theme.good;
                        }
                    }
                    // What the tip is doing; its own band, so it never
                    // covers the picture.
                    Text {
                        x: 12px; y: parent.height - 30px;
                        width: parent.width - 24px; height: 24px;
                        vertical-alignment: center;
                        text: Live.pr-caption;
                        font-family: Theme.display;
                        font-size: 17px;
                        letter-spacing: 1.2px;
                        color: Theme.good;
                        overflow: elide;
                    }
                }
                OptRow { label: Live.pr-opts-label; opts: Live.pr-opts; enabled: !Live.pr-running; }
                OptRow { label: Live.pr-opts2-label; opts: Live.pr-opts2; enabled: !Live.pr-running; }
                Step { text: "RESULT"; }
                Rectangle {
                    height: 150px;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    Text { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px; text: Live.pr-result; font-family: Theme.body; font-size: 22px; color: Theme.ink; wrap: word-wrap; vertical-alignment: top; }
                }
            }
        }
        // 3 · Settings and 4 · Start
        Card {
            width: Layout.compact ? 380px : 420px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Step { text: "3 · SETTINGS"; }
                // Write-to in FIND; what the mode does otherwise. Same slot.
                Rectangle {
                    height: 60px;
                    if Live.pr-show-wcs: HorizontalLayout {
                        spacing: 12px;
                        Label { width: 110px; vertical-alignment: center; text: "WRITE TO"; }
                        Btn { horizontal-stretch: 1; height: 60px; text: Live.pr-wcs + "  ▾"; font-size: 28px; enabled: !Live.pr-running; clicked => { root.wcs-open = true; } }
                    }
                    if !Live.pr-show-wcs: Note { vertical-alignment: center; text: Live.pr-note; }
                }
                // Three fixed value slots (no routine has more key values).
                // Always three slots; an empty one (no id) keeps its place.
                for p in Live.pr-params: Rectangle {
                    height: 106px;
                    if p.id != "": Stepper { width: parent.width; p: p; enabled: !Live.pr-running; }
                }
                HorizontalLayout {
                    height: 60px;
                    spacing: 8px;
                    Btn { horizontal-stretch: 1; font-size: 20px; text: Live.pr-more.length > 0 ? "MORE · " + Live.pr-more.length : "MORE"; enabled: Live.pr-more.length > 0; clicked => { root.more-open = true; } }
                    Btn { horizontal-stretch: 1; font-size: 20px; text: "RESET ALL"; enabled: Live.pr-changed && !Live.pr-running; clicked => { Actions.probe-reset-all(); } }
                    Btn { horizontal-stretch: 1; font-size: 20px; text: "DEFAULTS"; clicked => { root.defaults-open = true; } }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 40px;
                    spacing: 10px;
                    Step { height: 40px; horizontal-stretch: 1; text: "4 · START"; }
                    Pill { text: Live.pr-pill; kind: Live.pr-pill-kind; }
                }
                // One status line, always the same height.
                Text {
                    height: 50px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    font-family: Theme.body;
                    font-size: 19px;
                    overflow: elide;
                    color: Live.pr-running || Live.pr-ready != "" ? Theme.warn : Theme.muted;
                    text: Live.pr-running ? "RUNNING…" : Live.pr-ready != "" ? Live.pr-ready : "Ready.";
                }
                Btn { height: 60px; font-size: 22px; text: Live.pr-load-label; enabled: Live.pr-load-enabled && !locked && Live.power && !Live.pr-running; clicked => { Actions.probe-load(); } }
                HorizontalLayout {
                    height: 76px;
                    spacing: 10px;
                    Btn { width: 130px; kind: "stop"; text: "STOP"; clicked => { Actions.probe-stop(); } }
                    Btn { horizontal-stretch: 1; kind: "go"; hold: true; text: Live.pr-run-label; enabled: Live.pr-ready == "" && !locked; clicked => { Actions.probe-run(); } }
                }
            }
        }
    }
    if more-open: Dialog {
        title: "MORE SETTINGS · THIS RUN ONLY";
        dw: 1300px;
        // Sized to the rows so no empty band is left below them.
        dh: min(900px, 140px + ceil(Live.pr-more.length / 3) * 116px);
        close => { root.more-open = false; }
        Note { text: "Changed values show in amber and go back to the default after the run. Defaults live under DEFAULTS."; }
        GridLayout {
            spacing: 10px;
            for p[i] in Live.pr-more: Stepper { col: mod(i, 3); row: floor(i / 3); p: p; enabled: !Live.pr-running; }
        }
        Rectangle { vertical-stretch: 1; }
    }
    if defaults-open: Dialog {
        title: "PROBE DEFAULTS";
        dw: 1300px;
        dh: 840px;
        close => { root.defaults-open = false; }
        HorizontalLayout {
            height: 60px;
            spacing: 0;
            Seg { horizontal-stretch: 1; text: "TOUCH PROBE"; on: root.defaults-tab == "probe"; clicked => { root.defaults-tab = "probe"; } }
            Seg { horizontal-stretch: 1; text: "TOOL SETTER"; on: root.defaults-tab == "setter"; clicked => { root.defaults-tab = "setter"; } }
            Seg { horizontal-stretch: 1; text: "CALIBRATION"; on: root.defaults-tab == "cal"; clicked => { root.defaults-tab = "cal"; } }
        }
        Note { height: 28px; text: "Saved values (#3004–#3037). Tap one to change it; it is written to LinuxCNC now."; }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.well;
            border-radius: Theme.radius-ctl;
            clip: true;
            Flickable {
                content-height: dlist.preferred-height;
                dlist := VerticalLayout {
                    padding: 8px;
                    for p in Live.pr-defaults: Rectangle {
                        visible: p.def == root.defaults-tab;
                        height: p.def == root.defaults-tab ? 66px : 0px;
                        Rectangle {
                            y: 3px;
                            height: parent.height - 6px;
                            background: dt.pressed ? Theme.raised : Theme.panel2;
                            border-radius: Theme.radius-ctl;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;
                                Label { width: 90px; vertical-alignment: center; text: "#" + p.id; color: Theme.dim; }
                                Label { horizontal-stretch: 1; vertical-alignment: center; text: p.label; font-size: 22px; color: Theme.ink; overflow: elide; }
                                Text { width: 260px; horizontal-alignment: right; vertical-alignment: center; text: p.value + (p.unit != "" ? " " + p.unit : ""); font-family: Theme.body; font-weight: 600; font-size: 26px; color: Theme.ink; overflow: elide; }
                            }
                            dt := TouchArea { clicked => { Actions.edit("pdef-" + p.id); } }
                        }
                    }
                }
            }
        }
    }
    if wcs-open: Dialog {
        title: "WRITE TO";
        dw: 520px;
        dh: 860px;
        close => { root.wcs-open = false; }
        for c in Live.wcs-codes: Btn {
            height: 66px;
            font-size: 30px;
            text: c;
            on: c == Live.pr-wcs;
            clicked => { Actions.probe-wcs(c); root.wcs-open = false; }
        }
    }
}
