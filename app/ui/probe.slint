import { Theme, Layout } from "theme.slint";
import { Live, Actions, ProbeItem, ProbeOpt, ProbeSpot, ProbeParam } from "state.slint";
import { Btn, EqBtn, Seg, Card, Label, Caption, NumField, H3, Note } from "widgets.slint";
import { Scrim, Dialog, DialogTitle } from "overlays.slint";

// One run value under ALL SETTINGS: its name (and the default once
// changed), then − value + and a RESET that only shows when the value
// differs from the default. Its slot is always reserved, so changing a
// value moves nothing. The value is the shared NumField.
component Stepper inherits Rectangle {
    in property <ProbeParam> p;
    in property <bool> enabled: true;
    background: p.changed ? Theme.warn-soft : Theme.panel2;
    animate background { duration: Theme.settle; }
    border-radius: Theme.radius-ctl;
    min-width: 300px;
    horizontal-stretch: 1;
    height: 106px;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Label {
            height: 26px;
            vertical-alignment: center;
            text: p.label + (p.changed ? "   ·   DEFAULT " + p.def : "");
            overflow: elide;
            color: p.changed ? Theme.warn : Theme.muted;
        }
        HorizontalLayout {
            height: Theme.h-ctl;
            spacing: 6px;
            Btn { width: 64px; text: "−"; font-size: Theme.t-big; enabled: root.enabled; clicked => { Actions.probe-step(p.id, -1); } }
            NumField { horizontal-stretch: 1; value: p.value; unit: p.unit; changed: p.changed; enabled: root.enabled; edit => { Actions.edit("prun-" + p.id); } }
            Btn { width: 64px; text: "+"; font-size: Theme.t-big; enabled: root.enabled; clicked => { Actions.probe-step(p.id, 1); } }
            Rectangle {
                width: 96px;
                if p.changed: Btn { width: parent.width; height: parent.height; text: "RESET"; font-size: Theme.t-body; enabled: root.enabled; clicked => { Actions.probe-reset(p.id); } }
            }
        }
    }
}

// A named group of choices for the target: the name, then the choices as
// one segmented track across the card (they are either/or). An empty group
// keeps its height, so the start buttons below never move.
component OptGroup inherits VerticalLayout {
    in property <string> label;
    in property <[ProbeOpt]> opts;
    in property <bool> enabled: true;
    height: 84px;
    spacing: 4px;
    Label { height: 24px; vertical-alignment: center; text: root.label; overflow: elide; }
    HorizontalLayout {
        height: Theme.h-ctl;
        spacing: 0px;
        for o[i] in root.opts: Seg {
            first: i == 0;
            last: i == root.opts.length - 1;
            font-size: Theme.t-body;
            text: o.label;
            on: o.on;
            enabled: o.enabled && root.enabled;
            clicked => { Actions.probe-opt(o.id); }
        }
    }
}

// One run value on the screen: its name beside the shared NumField. The
// whole row opens the keypad. A value changed for this run is amber; the
// − / + steps, its default and its own RESET are under ALL SETTINGS.
component ValueRow inherits Rectangle {
    in property <ProbeParam> p;
    in property <bool> enabled: true;
    height: Theme.h-ctl;
    HorizontalLayout {
        spacing: 10px;
        Label { horizontal-stretch: 1; vertical-alignment: center; text: p.label; overflow: elide; color: p.changed ? Theme.warn : Theme.muted; }
        NumField { width: 190px; value: p.value; unit: p.unit; changed: p.changed; enabled: root.enabled; }
    }
    TouchArea { enabled: root.enabled; clicked => { Actions.edit("prun-" + p.id); } }
}

export component ProbeScreen inherits Rectangle {
    property <bool> locked: Live.manual-locked;
    property <bool> more-open: Live.pr-dialog == "more";
    property <bool> defaults-open: Live.pr-dialog == "defaults";
    property <string> defaults-tab: "probe";
    property <bool> wcs-open: Live.pr-dialog == "wcs";
    property <bool> job-open: Live.pr-dialog == "job";
    // The picture shows either the approach arrows or the preview, never both.
    property <bool> arrows: (Live.pr-running || !Live.pr-preview) && !Live.pr-scan;
    property <bool> tip: Live.pr-tip-on && !self.arrows && !Live.pr-scan;
    // The browser build redraws a changed Path over open overlays.
    property <bool> paths-visible: !(Live.tc-open || Live.pick-open || Live.keypad-open || Live.drawer-open || Live.pr-dialog != "");
    // Three cards, left to right: what to probe, where on it, then the
    // few values that matter and the start. Every slot below has a fixed
    // size: changing the mode, shape or target changes what is in a slot,
    // never where anything is. Anything not needed for most runs (every
    // other value, the saved defaults, the two kinds of job step) is one
    // tap away in a dialog.
    HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        // What: mode and shape
        Card {
            width: Layout.compact ? 250px : 290px;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                HorizontalLayout {
                    // Probe the part (setting an offset, or WRITE TO NOTHING
                    // to only measure), or calibrate the probe and setter.
                    Seg { horizontal-stretch: 1; first: true; text: "PART"; font-size: Theme.t-body; on: Live.pr-mode == "find"; enabled: !Live.pr-running; clicked => { Actions.probe-mode("find"); } }
                    Seg { horizontal-stretch: 1; last: true; text: "CALIBRATE"; font-size: Theme.t-body; on: Live.pr-mode == "cal"; enabled: !Live.pr-running; clicked => { Actions.probe-mode("cal"); } }
                }
                for s in Live.pr-shapes: Btn { height: Theme.h-choice; text: s.label; on: s.on; enabled: !Live.pr-running; clicked => { Actions.probe-shape(s.id); } }
                Rectangle { vertical-stretch: 1; }
            }
        }
        // Where: the picture (its spots are the only controls on it) and
        // the result.
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                // The target, and beside it what the routine does there.
                HorizontalLayout {
                    height: 34px;
                    spacing: 14px;
                    H3 { vertical-alignment: center; text: Live.pr-title; overflow: elide; }
                    // (No room for it beside the title in a narrow window.)
                    Note { horizontal-stretch: 1; min-width: 0; vertical-alignment: center; horizontal-alignment: right; wrap: no-wrap; overflow: elide; color: Theme.dim; text: Layout.compact ? "" : Live.pr-routine; }
                }
                pic := Rectangle {
                    vertical-stretch: 1;
                    min-height: 300px;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    // A band above for the hint and one below for the preview's caption.
                    property <float> sc: min(self.width / 400px, (self.height - 64px) / 300px);
                    property <length> ox: (self.width - 400px * sc) / 2;
                    property <length> oy: 32px + (self.height - 64px - 300px * sc) / 2;
                    Text { x: 0; y: 6px; width: parent.width; horizontal-alignment: center; text: Live.pr-hint; font-family: Theme.body; font-size: Theme.t-body; color: Theme.dim; }
                    Path {
                        visible: root.paths-visible;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-outline;
                        stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                    }
                    // The part on the rotary, turning with A in the preview.
                    Path {
                        visible: root.paths-visible;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-part;
                        stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                    }
                    for sp in Live.pr-spots: Rectangle {
                        property <bool> edge: sp.w > 0;
                        x: pic.ox + (edge ? sp.x : (sp.x - sp.r)) * pic.sc * 1px;
                        y: pic.oy + (edge ? sp.y : (sp.y - sp.r)) * pic.sc * 1px;
                        width: (edge ? sp.w : 2 * sp.r) * pic.sc * 1px;
                        height: (edge ? sp.h : 2 * sp.r) * pic.sc * 1px;
                        border-radius: (edge ? 8 : sp.r) * pic.sc * 1px;
                        background: sp.on ? Theme.warn.with-alpha(0.4) : st.pressed ? Theme.sel.with-alpha(0.5) : Theme.sel.with-alpha(0.08);
                        border-width: sp.on ? 3px : 2px;
                        border-color: sp.on ? Theme.warn : Theme.sel.with-alpha(0.7);
                        animate background, border-color { duration: Theme.quick; }
                        st := TouchArea { enabled: !Live.pr-running; clicked => { Actions.probe-target(sp.id); } }
                    }
                    // Approach moves, drawn over the spots (not tappable). The
                    // preview shows the same moves, so they only show without
                    // it. (Not from pr-tip-on, which may still be on its way
                    // from the mill to a browser screen.)
                    Path {
                        visible: root.paths-visible && root.arrows;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-arrows;
                        stroke: Theme.warn.with-alpha(0.75); stroke-width: 2px; fill: transparent;
                    }
                    Path {
                        visible: root.paths-visible && root.arrows;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-heads;
                        fill: Theme.warn; stroke: transparent;
                    }
                    // The preview: the tip plays the routine in a loop.
                    // Green is the preview; amber stays the approach arrows.
                    Path {
                        visible: root.paths-visible && root.tip;
                        x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                        viewbox-width: 400; viewbox-height: 300;
                        commands: Live.pr-trail;
                        stroke: Theme.good.with-alpha(0.8); stroke-width: 3px; fill: transparent;
                    }
                    if root.tip: Rectangle {
                        // Clear of the part the tip is drawn larger and fainter.
                        property <length> r: (6 + 5 * Live.pr-tip-z) * pic.sc * 1px;
                        visible: root.paths-visible;
                        x: pic.ox + Live.pr-tip-x * pic.sc * 1px - self.r;
                        y: pic.oy + Live.pr-tip-y * pic.sc * 1px - self.r;
                        width: 2 * self.r; height: 2 * self.r;
                        border-radius: self.r;
                        background: Theme.good.with-alpha(0.9 - 0.55 * Live.pr-tip-z);
                        border-width: 2px;
                        border-color: Theme.good;
                        // The touch.
                        Rectangle {
                            visible: Live.pr-tip-contact;
                            x: -parent.r * 0.8; y: -parent.r * 0.8;
                            width: 3.6 * parent.r; height: 3.6 * parent.r;
                            border-radius: 1.8 * parent.r;
                            border-width: 2px;
                            border-color: Theme.good;
                        }
                    }
                    // Points to drag: the 3-point touches around the circle,
                    // or SET ROTATION's two along the edge. Each takes its
                    // own drag (the pointer in picture units); the rest of
                    // the picture stays tappable.
                    for pt in Live.pr-points: Rectangle {
                        property <length> r: pt.r * pic.sc * 1px;
                        // A touch target larger than the drawn point.
                        property <length> hit: max(self.r + 12px, 30px);
                        x: pic.ox + pt.x * pic.sc * 1px - self.r;
                        y: pic.oy + pt.y * pic.sc * 1px - self.r;
                        width: 2 * self.r; height: 2 * self.r;
                        border-radius: self.r;
                        background: pt.on ? Theme.warn.with-alpha(0.55) : Theme.sel.with-alpha(0.3);
                        border-width: pt.on ? 3px : 2px;
                        border-color: pt.on ? Theme.warn : Theme.sel;
                        animate background, border-color { duration: Theme.quick; }
                        Text { text: pt.id; font-family: Theme.body; font-weight: 700; font-size: Theme.t-body; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
                        ta := TouchArea {
                            x: parent.r - parent.hit; y: parent.r - parent.hit;
                            width: 2 * parent.hit; height: 2 * parent.hit;
                            enabled: !Live.pr-running;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    Actions.probe-drag(0, (parent.x + self.x + self.mouse-x - pic.ox) / pic.sc / 1px, (parent.y + self.y + self.mouse-y - pic.oy) / pic.sc / 1px);
                                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                    Actions.probe-drag(2, 0, 0);
                                }
                            }
                            moved => {
                                if self.pressed {
                                    Actions.probe-drag(1, (parent.x + self.x + self.mouse-x - pic.ox) / pic.sc / 1px, (parent.y + self.y + self.mouse-y - pic.oy) / pic.sc / 1px);
                                }
                            }
                        }
                    }
                    // ROUND BOSS › SCAN: what the scan touched, in 3D, over
                    // the picture once there are touches. Drag to turn it.
                    if Live.pr-scan: Rectangle {
                        x: 0; y: 0; width: parent.width; height: parent.height;
                        background: Theme.well;
                        Text { x: 0; y: 6px; width: parent.width; horizontal-alignment: center; text: Live.pr-hint; font-family: Theme.body; font-size: Theme.t-body; color: Theme.dim; }
                        Path {
                            x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                            viewbox-width: 400; viewbox-height: 300;
                            commands: Live.pr-scan-below;
                            stroke: Theme.dim.with-alpha(0.45); stroke-width: 1.5px; fill: transparent;
                        }
                        Path {
                            x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                            viewbox-width: 400; viewbox-height: 300;
                            commands: Live.pr-scan-face;
                            fill: Theme.sel.with-alpha(0.10); stroke: transparent;
                        }
                        Path {
                            x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                            viewbox-width: 400; viewbox-height: 300;
                            commands: Live.pr-scan-path;
                            stroke: Theme.muted.with-alpha(0.3); stroke-width: 1.5px; fill: transparent;
                        }
                        Path {
                            x: pic.ox; y: pic.oy; width: 400px * pic.sc; height: 300px * pic.sc;
                            viewbox-width: 400; viewbox-height: 300;
                            commands: Live.pr-scan-edges;
                            stroke: Theme.sel-ink.with-alpha(0.8); stroke-width: 2px; fill: transparent;
                        }
                        for t in Live.pr-scan-touches: Rectangle {
                            property <length> r: t.id == "miss" ? 4px : 6px;
                            x: pic.ox + t.x * pic.sc * 1px - self.r;
                            y: pic.oy + t.y * pic.sc * 1px - self.r;
                            width: 2 * self.r; height: 2 * self.r;
                            border-radius: self.r;
                            background: t.id == "top" ? Theme.good : t.id == "side" ? Theme.info : transparent;
                            border-width: t.id == "miss" ? 2px : 1.5px;
                            border-color: t.id == "miss" ? Theme.dim : Theme.well;
                        }
                        for l in Live.pr-scan-labels: Rectangle {
                            property <length> w: lt.preferred-width + 16px;
                            x: pic.ox + l.x * pic.sc * 1px - self.w / 2;
                            y: pic.oy + l.y * pic.sc * 1px - 16px;
                            width: self.w; height: 32px;
                            border-radius: 6px;
                            background: Theme.well.with-alpha(0.85);
                            lt := Text { text: l.id; font-family: Theme.body; font-weight: 600; font-size: Theme.t-ctl; color: Theme.info; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            x: 16px; y: parent.height - 32px; height: 24px;
                            spacing: 24px;
                            alignment: start;
                            for k in [{ c: Theme.good, t: "TOP", miss: false }, { c: Theme.info, t: "SIDE", miss: false }, { c: Theme.dim, t: "NOTHING THERE", miss: true }]: HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    width: 12px; height: 12px; y: 6px;
                                    border-radius: 6px;
                                    background: k.miss ? transparent : k.c;
                                    border-width: k.miss ? 2px : 0;
                                    border-color: k.c;
                                }
                                Caption { vertical-alignment: center; text: k.t; }
                            }
                        }
                        TouchArea {
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    Actions.probe-orbit(0, (self.mouse-x - pic.ox) / pic.sc / 1px, (self.mouse-y - pic.oy) / pic.sc / 1px);
                                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                    Actions.probe-orbit(2, 0, 0);
                                }
                            }
                            moved => {
                                if self.pressed {
                                    Actions.probe-orbit(1, (self.mouse-x - pic.ox) / pic.sc / 1px, (self.mouse-y - pic.oy) / pic.sc / 1px);
                                }
                            }
                        }
                    }
                    // What the tip is doing; its own band, so it never
                    // covers the picture.
                    Caption {
                        x: 16px; y: parent.height - 32px;
                        width: parent.width - 32px; height: 24px;
                        vertical-alignment: center;
                        visible: !Live.pr-scan;
                        text: Live.pr-caption;
                        color: Theme.good;
                        overflow: elide;
                    }
                }
                // The result: one wrapped line of values, quiet until there is one.
                Rectangle {
                    height: 96px;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    property <bool> none: Live.pr-result == "No measurement yet.";
                    Text { x: 14px; y: 8px; width: parent.width - 28px; height: parent.height - 16px; text: Live.pr-result; font-family: Theme.body; font-size: Theme.t-ctl; color: parent.none ? Theme.dim : Theme.ink; wrap: word-wrap; vertical-alignment: parent.none ? center : top; overflow: elide; }
                }
            }
        }
        // The values for this run, then the start
        Card {
            width: Layout.compact ? 380px : 420px;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.row;
                // Write-to in FIND; what the mode does otherwise. Same slot.
                Rectangle {
                    height: Theme.h-ctl;
                    if Live.pr-show-wcs: HorizontalLayout {
                        spacing: 10px;
                        Label { horizontal-stretch: 1; vertical-alignment: center; text: "WRITE TO"; }
                        Btn { width: 190px; height: Theme.h-ctl; menu: true; text: Live.pr-wcs; family: Theme.body; font-size: Theme.t-value; enabled: !Live.pr-running; clicked => { Live.pr-dialog = "wcs"; } }
                    }
                    if !Live.pr-show-wcs: Note { height: parent.height; vertical-alignment: center; text: Live.pr-note; }
                }
                // Three fixed value slots (no routine has more key values).
                // Always three slots; an empty one (no id) keeps its place.
                for p in Live.pr-params: Rectangle {
                    height: Theme.h-ctl;
                    if p.id != "": ValueRow { width: parent.width; p: p; enabled: !Live.pr-running; }
                }
                HorizontalLayout {
                    height: Theme.h-ctl;
                    spacing: 10px;
                    Btn { horizontal-stretch: 2; font-size: Theme.t-body; text: "ALL SETTINGS"; clicked => { Live.pr-dialog = "more"; } }
                    Btn { horizontal-stretch: 1; font-size: Theme.t-body; text: "RESET"; enabled: Live.pr-changed && !Live.pr-running; clicked => { Actions.probe-reset-all(); } }
                }
                // The choices the target has (which sides, ridge or slot…).
                OptGroup { label: Live.pr-opts-label; opts: Live.pr-opts; enabled: !Live.pr-running; }
                OptGroup { label: Live.pr-opts2-label; opts: Live.pr-opts2; enabled: !Live.pr-running; }
                Rectangle { vertical-stretch: 1; }
                // One slot says whether it can start: the tool change when
                // only the tool is in the way, otherwise ready or why not.
                Rectangle {
                    height: Theme.h-ctl;
                    property <bool> offer: Live.pr-load-offer && !Live.pr-running;
                    if self.offer: Btn { width: parent.width; height: parent.height; font-size: Theme.t-ctl; text: Live.pr-load-label; enabled: Live.pr-load-enabled && !locked && Live.power; clicked => { Actions.probe-load(); } }
                    if !self.offer: Text {
                        width: parent.width;
                        height: parent.height;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        font-family: Theme.body;
                        font-size: Theme.t-body;
                        overflow: elide;
                        color: Live.pr-running || Live.pr-ready != "" ? Theme.warn : Theme.good;
                        text: Live.pr-running ? "Running…  STOP is in the bar below." : Live.pr-ready != "" ? Live.pr-ready : Live.pr-pill;
                    }
                }
                // STOP is the bar's STOP, always in the same place.
                HorizontalLayout {
                    height: Theme.h-big;
                    spacing: 10px;
                    Btn { width: 120px; font-size: Theme.t-body; text: "ADD TO\nJOB"; enabled: Live.pr-job-ok && !locked && !Live.pr-running; clicked => { Live.pr-dialog = "job"; } }
                    Btn { horizontal-stretch: 1; kind: "go"; hold: true; font-size: Theme.t-value; text: Live.pr-run-label; enabled: Live.pr-ready == "" && !locked; clicked => { Actions.probe-run(); } }
                }
            }
        }
    }
    if more-open: Scrim {
        Dialog {
            width: min(1300px, parent.width - 2 * Theme.gap);
            // Sized to the rows so no empty band is left below them.
            height: min(940px, 228px + ceil(Live.pr-more.length / 3) * 116px);
            VerticalLayout {
                padding: Theme.dlg-pad;
                spacing: Theme.dlg-row;
                DialogTitle { text: "ALL SETTINGS · THIS RUN ONLY"; }
                Note { height: 28px; text: "A changed value shows in amber and goes back to its default after the run."; }
                GridLayout {
                    spacing: 10px;
                    for p[i] in Live.pr-more: Stepper { col: mod(i, 3); row: floor(i / 3); p: p; enabled: !Live.pr-running; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: Theme.h-choice;
                    spacing: 12px;
                    Btn { width: 260px; text: "RESET ALL"; enabled: Live.pr-changed && !Live.pr-running; clicked => { Actions.probe-reset-all(); } }
                    Btn { width: 260px; text: "SAVED DEFAULTS"; clicked => { Live.pr-dialog = "defaults"; } }
                    Rectangle { horizontal-stretch: 1; }
                    Btn { width: 260px; text: "DONE"; clicked => { Live.pr-dialog = ""; } }
                }
            }
        }
    }
    if job-open: Scrim {
        Dialog {
            width: 900px;
            height: 400px;
            VerticalLayout {
                padding: Theme.dlg-pad;
                spacing: Theme.dlg-row;
                DialogTitle { text: "ADD TO THE JOB · " + Live.pr-title; }
                Note { height: 28px; text: "The job will run this routine from where the probe is now."; }
                // Two equal halves: the step that sets the offset, and the one
                // that only measures. Each says what it does underneath.
                HorizontalLayout {
                    spacing: 12px;
                    for check in [false, true]: VerticalLayout {
                        width: (parent.width - 12px) / 2;
                        spacing: 8px;
                        Btn {
                            height: Theme.h-big;
                            font-size: Theme.t-value;
                            text: check ? "CHECK A SIZE" : "SET " + Live.pr-wcs;
                            enabled: check ? Live.pr-job-check : Live.pr-wcs != "NOTHING";
                            clicked => { Actions.probe-add-job(check); Live.pr-dialog = ""; }
                        }
                        Note {
                            height: 50px;
                            min-width: 0;
                            horizontal-alignment: center;
                            vertical-alignment: top;
                            text: !check ? (Live.pr-wcs == "NOTHING" ? "WRITE TO is NOTHING: pick a work offset to set one." : "Probes and writes the work offset.") : Live.pr-job-check ? "Measures and reports. Offsets stay as they are." : "Only a bore, boss, pocket, slot, ridge or top face can be checked.";
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: Theme.h-choice;
                    Btn { width: 260px; text: "CANCEL"; clicked => { Live.pr-dialog = ""; } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
    if defaults-open: Scrim {
        Dialog {
            width: min(1300px, parent.width - 2 * Theme.gap);
            height: 840px;
            VerticalLayout {
                padding: Theme.dlg-pad;
                spacing: Theme.dlg-row;
                DialogTitle { text: "PROBE DEFAULTS"; }
                HorizontalLayout {
                    spacing: 0;
                    Seg { first: true; text: "TOUCH PROBE"; on: root.defaults-tab == "probe"; clicked => { root.defaults-tab = "probe"; } }
                    Seg { text: "TOOL SETTER"; on: root.defaults-tab == "setter"; clicked => { root.defaults-tab = "setter"; } }
                    Seg { last: true; text: "CALIBRATION"; on: root.defaults-tab == "cal"; clicked => { root.defaults-tab = "cal"; } }
                }
                Note { height: 28px; text: "Saved values (#3004–#3037). Tap one to change it; it is written to LinuxCNC now."; }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.well;
                    border-radius: Theme.radius-ctl;
                    clip: true;
                    Flickable {
                        content-height: dlist.preferred-height;
                        dlist := VerticalLayout {
                            padding: 8px;
                            for p in Live.pr-defaults: Rectangle {
                                visible: p.def == root.defaults-tab;
                                height: p.def == root.defaults-tab ? 62px : 0px;
                                Rectangle {
                                    y: 3px;
                                    height: parent.height - 6px;
                                    background: dt.pressed ? Theme.raised : Theme.panel2;
                                    border-radius: Theme.radius-ctl;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 6px;
                                        Caption { width: 90px; vertical-alignment: center; text: "#" + p.id; }
                                        Label { horizontal-stretch: 1; vertical-alignment: center; text: p.label; color: Theme.ink; overflow: elide; }
                                        // The value with its unit small and dim after it, as in every field.
                                        Text { horizontal-alignment: right; vertical-alignment: center; text: p.value; font-family: Theme.body; font-weight: 600; font-size: Theme.t-value; color: Theme.ink; }
                                        Text { width: 70px; vertical-alignment: center; text: p.unit; font-family: Theme.body; font-size: Theme.t-small; color: Theme.dim; }
                                    }
                                    dt := TouchArea { clicked => { Actions.edit("pdef-" + p.id); } }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: Theme.h-choice;
                    Rectangle { horizontal-stretch: 1; }
                    Btn { width: 260px; text: "DONE"; clicked => { Live.pr-dialog = ""; } }
                }
            }
        }
    }
    // The same list as every other picker: Barlow items, CANCEL at the foot.
    if wcs-open: Scrim {
        Dialog {
            width: 760px;
            height: min(900px, 176px + (Live.wcs-codes.length + 1) * 72px);
            VerticalLayout {
                padding: Theme.dlg-pad;
                spacing: Theme.dlg-row;
                DialogTitle { text: "WRITE TO"; }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    Flickable {
                        content-height: wlist.preferred-height;
                        wlist := VerticalLayout {
                            spacing: 8px;
                            for c in Live.wcs-codes: Btn {
                                height: Theme.h-choice;
                                family: Theme.body;
                                font-size: Theme.t-value;
                                text: c;
                                on: c == Live.pr-wcs;
                                clicked => { Actions.probe-wcs(c); Live.pr-dialog = ""; }
                            }
                            // Report the result and write no offset at all.
                            Btn {
                                height: Theme.h-choice;
                                family: Theme.body;
                                font-size: Theme.t-value;
                                text: "NOTHING · MEASURE ONLY";
                                on: Live.pr-wcs == "NOTHING";
                                clicked => { Actions.probe-wcs("NOTHING"); Live.pr-dialog = ""; }
                            }
                        }
                    }
                }
                Btn { height: Theme.h-choice; text: "CANCEL"; clicked => { Live.pr-dialog = ""; } }
            }
        }
    }
}
