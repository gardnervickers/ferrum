// Overlays cover only the middle band, so the status bar (E-STOP, power)
// and the cycle bar (feed hold, stop, cycle start) stay usable.
import { Theme } from "theme.slint";
import { Live, Actions, MsgRow } from "state.slint";
import { Btn, Label, H3, Note, Pill } from "widgets.slint";

component Scrim inherits Rectangle {
    background: #050708a0;
    TouchArea { }  // swallow taps behind the dialog
}

component Dialog inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 10px;
}

export component Keypad inherits Scrim {
    Dialog {
        width: 500px;
        height: 640px;
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: Live.keypad-label; font-family: Theme.display; font-size: 38px; letter-spacing: 2px; color: Theme.ink; }
            Rectangle {
                height: 76px;
                background: Theme.well;
                border-width: 1px;
                border-color: Theme.sel;
                border-radius: 6px;
                // Shown selected until the first key replaces it.
                if Live.keypad-fresh: Rectangle {
                    x: parent.width - 16px - self.width + 6px;
                    width: fresh-text.preferred-width + 12px;
                    height: 60px;
                    border-radius: 4px;
                    background: Theme.sel.with-alpha(0.45);
                }
                fresh-text := Text {
                    x: 16px;
                    width: parent.width - 32px;
                    horizontal-alignment: right;
                    text: Live.keypad-value == "" ? "0" : Live.keypad-value;
                    font-family: Theme.body; font-weight: 600; font-size: 46px; color: Theme.ink;
                }
            }
            GridLayout {
                spacing: 10px;
                Row { for k in ["7", "8", "9", "⌫"]: Btn { height: 84px; font-size: 36px; text: k; clicked => { Actions.keypad-key(k); } } }
                Row { for k in ["4", "5", "6", "±"]: Btn { height: 84px; font-size: 36px; text: k; clicked => { Actions.keypad-key(k); } } }
                Row { for k in ["1", "2", "3", "CLR"]: Btn { height: 84px; font-size: k == "CLR" ? 28px : 36px; text: k; clicked => { Actions.keypad-key(k); } } }
                Row {
                    Btn { height: 84px; font-size: 36px; text: "0"; clicked => { Actions.keypad-key("0"); } }
                    Btn { height: 84px; font-size: 36px; text: "."; clicked => { Actions.keypad-key("."); } }
                }
            }
            HorizontalLayout {
                spacing: 20px;
                Btn { text: "CANCEL"; clicked => { Actions.keypad-done(false); } }
                Btn { text: "ENTER"; kind: "go"; clicked => { Actions.keypad-done(true); } }
            }
        }
    }
}

export component MessageDrawer inherits Scrim {
    Dialog {
        width: 1100px;
        height: 760px;
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                Text { text: "MESSAGES"; font-family: Theme.display; font-size: 38px; letter-spacing: 2px; color: Theme.ink; horizontal-stretch: 1; }
                Note { vertical-alignment: center; text: "Errors, (MSG), (DEBUG) and (PRINT) output, newest first"; }
            }
            Rectangle {
                vertical-stretch: 1;
                background: Theme.well;
                border-radius: 6px;
                clip: true;
                Flickable {
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        alignment: start;
                        for m in Live.messages: HorizontalLayout {
                            spacing: 14px;
                            Text { width: 90px; text: m.time; font-family: Theme.body; font-size: 20px; color: Theme.dim; }
                            Text {
                                horizontal-stretch: 1;
                                text: m.text;
                                wrap: word-wrap;
                                font-family: Theme.body;
                                font-size: 22px;
                                color: m.kind == "error" ? #ff8f8a : m.kind == "display" ? #8cc4ef : Theme.ink;
                            }
                        }
                        if Live.messages.length == 0: Note { text: "No messages."; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 20px;
                Btn { width: 240px; text: "CLEAR"; clicked => { Actions.clear-messages(); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { width: 240px; text: "CLOSE"; kind: "go"; clicked => { Live.drawer-open = false; } }
            }
        }
    }
}

component ToolCard inherits Rectangle {
    in property <string> title;
    in property <string> tool;
    in property <string> desc;
    in property <bool> highlight;
    background: Theme.panel2;
    border-radius: 8px;
    border-width: highlight ? 2px : 0px;
    border-color: #d99a1e;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        Label { height: 24px; text: title; }
        Text { height: 56px; text: tool; font-family: Theme.body; font-weight: 600; font-size: 48px; color: Theme.ink; }
        Text { height: 50px; text: desc; wrap: word-wrap; overflow: elide; font-family: Theme.body; font-size: 19px; color: Theme.muted; }
    }
}

// Manual tool change (mockup ovTc; behaviour of mymill_vcp/toolchange_dialog.py).
export component ToolChange inherits Scrim {
    Dialog {
        width: 900px;
        height: 820px;
        VerticalLayout {
            padding: 22px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                Text { vertical-alignment: center; text: "TOOL CHANGE"; font-family: Theme.display; font-size: 40px; letter-spacing: 2px; color: Theme.ink; }
                Rectangle { horizontal-stretch: 1; }
                Pill { text: Live.tc-nose; kind: Live.tc-nose-kind; }
            }
            HorizontalLayout {
                spacing: 14px;
                height: 170px;
                ToolCard { width: 421px; title: "REMOVE"; tool: Live.tc-from; desc: Live.tc-from-desc; }
                ToolCard { width: 421px; title: "INSERT"; tool: Live.tc-tool; desc: Live.tc-tool-desc; highlight: true; }
            }
            HorizontalLayout {
                spacing: 12px;
                Label { vertical-alignment: center; text: "DRAWBAR"; }
                Pill { text: Live.tc-drawbar == "EXTENDED" ? "EXTENDED · TOOL RELEASED" : Live.tc-drawbar == "RETRACTED" ? "RETRACTED · CLAMPED" : "UNKNOWN"; kind: Live.tc-drawbar == "EXTENDED" ? "bad" : Live.tc-drawbar == "RETRACTED" ? "good" : ""; }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 30px;
                Btn { preferred-width: 0; horizontal-stretch: 1; height: 84px; text: "RELEASE TOOL"; hold: true; enabled: Live.tc-can-extend; clicked => { Actions.tc-drawbar(true); } }
                Btn { preferred-width: 0; horizontal-stretch: 1; height: 84px; text: "CLAMP TOOL"; enabled: Live.tc-can-retract; clicked => { Actions.tc-drawbar(false); } }
            }
            // Slot kept when empty so the dialog never reflows.
            Rectangle {
                height: 48px;
                border-radius: 6px;
                background: Live.tc-scratch != "" ? #43361a : transparent;
                Text { text: Live.tc-scratch; font-family: Theme.display; font-size: 22px; letter-spacing: 1px; color: #f3c463; }
            }
            Rectangle {
                height: 72px;
                border-radius: 8px;
                background: Live.tc-seated ? #1f3a2a : Theme.well;
                border-width: 1px;
                border-color: Live.tc-seated ? #3fb86b : Theme.line;
                HorizontalLayout {
                    padding-left: 18px;
                    spacing: 18px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 40px;
                        height: 40px;
                        border-radius: 6px;
                        border-width: 2px;
                        border-color: Live.tc-seated ? #3fb86b : Theme.muted;
                        background: Live.tc-seated ? Theme.go : transparent;
                        if Live.tc-seated: Path { width: 28px; height: 28px; viewbox-width: 24; viewbox-height: 24; commands: "M4 12l5 5L20 6"; stroke: Theme.ink; stroke-width: 4px; fill: transparent; }
                    }
                    Text { vertical-alignment: center; text: "Tool is seated and the drawbar is clamped"; font-family: Theme.body; font-size: 26px; color: Theme.ink; }
                }
                TouchArea { clicked => { Actions.tc-seated-toggle(); } }
            }
            Text { height: 56px; text: Live.tc-message; wrap: word-wrap; overflow: elide; font-family: Theme.display; font-size: 22px; letter-spacing: 1px; color: Theme.muted; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 30px;
                Btn { height: 84px; text: "RESUME + TOUCH OFF"; enabled: Live.tc-can-touch-off; clicked => { Actions.tc-resume(true); } }
                Btn { height: 84px; text: "ABORT"; kind: "stop"; clicked => { Actions.tc-abort(); } }
                Btn { height: 84px; text: "RESUME"; kind: "go"; enabled: Live.tc-can-resume; clicked => { Actions.tc-resume(false); } }
            }
            Note { text: Live.tc-touch-off-tip + ". Touch off runs after the change, from the M6 remap. The spindle cannot start while the drawbar is extended."; wrap: word-wrap; height: 52px; }
        }
    }
}

// Pick one item from a list (picker.rs).
export component Picker inherits Scrim {
    Dialog {
        width: 760px;
        height: min(820px, 176px + Live.pick-items.length * 76px);
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: Live.pick-title; font-family: Theme.display; font-size: 38px; letter-spacing: 2px; color: Theme.ink; }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                Flickable {
                    content-height: items.preferred-height;
                    // Open with the current choice in view.
                    init => { self.content-y = -max(0px, min(Live.pick-current * 76px - 200px, items.preferred-height - self.height)); }
                    items := VerticalLayout {
                        spacing: 8px;
                        for it[i] in Live.pick-items: Btn { height: 68px; text: it; family: Theme.body; font-size: 28px; on: i == Live.pick-current; clicked => { Actions.pick(i); } }
                    }
                }
            }
            Btn { height: 64px; text: "CANCEL"; clicked => { Actions.pick(-1); } }
        }
    }
}
