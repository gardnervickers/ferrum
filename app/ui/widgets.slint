import { Theme } from "theme.slint";

// A small stroked chevron: "opens a list" (down), "open" (up), "goes
// somewhere" (right). Drawn, like the nav icons, not a font glyph.
export component Chevron inherits Path {
    in property <string> dir: "down";
    in property <color> color: Theme.muted;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: dir == "up" ? "M5 15l7-7 7 7" : dir == "right" ? "M9 5l7 7-7 7" : dir == "left" ? "M15 5l-7 7 7 7" : "M5 9l7 7 7-7";
    stroke: root.color;
    stroke-width: 2px;
    fill: transparent;
}

// Arrow icons for motion buttons (Btn.icon): the same 2px line as the nav.
export global Arrows {
    out property <string> up: "M12 20V5M5 12l7-7 7 7";
    out property <string> down: "M12 4v15M5 12l7 7 7-7";
    out property <string> left: "M20 12H5M12 5l-7 7 7 7";
    out property <string> right: "M4 12h15M12 5l7 7-7 7";
    out property <string> cw: "M20 12a8 8 0 1 1-3-6.2M17 2v4h-4";
    out property <string> ccw: "M4 12a8 8 0 1 0 3-6.2M7 2v4h4";
}

// The mockup's button. kind: "" | "go" | "hold" | "stop". With `hold`, the
// press must last 800 ms (a misuse safeguard, see ARCHITECTURE.md).
export component Btn inherits Rectangle {
    in property <string> text;
    // A small second line under the label.
    in property <string> sub;
    // A small caption over the label: the button shows a value to change.
    in property <string> cap;
    in property <string> icon;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> kind;
    in property <bool> hold;
    // Flat: no plate until chosen (the nav tabs).
    in property <bool> flat;
    // The chosen plate is drawn by the parent, which slides it between
    // buttons (the nav bar); this button only tints its label.
    in property <bool> glide;
    in property <length> font-size: Theme.t-btn;
    in property <string> family: Theme.display;
    // A stroked chevron at the right edge: the button opens a list.
    in property <bool> menu;
    // The label in the accent's ink on a plain plate: a key of another
    // kind in a pad (the keypad's operators), not a chosen state.
    in property <bool> accent;
    callback clicked();
    // Fires on touch-down, before any hold or release (E-STOP trips on it).
    callback pressed();
    // Fires when the touch ends or is cancelled (continuous jog stops on it).
    callback released();

    property <bool> arming: touch.pressed && hold && enabled && !fired;
    property <bool> fired;
    // Whether the current touch began on a hold button; the label (and
    // `hold`) can flip under the finger, so the release must not then act.
    property <bool> touch-held;
    preferred-height: Theme.h-ctl;
    border-radius: Theme.radius-ctl;
    property <bool> filled: kind == "go" || kind == "hold" || kind == "stop";
    background: kind == "go" ? Theme.go : kind == "hold" ? Theme.hold : kind == "stop" ? Theme.stop
        : kind == "tripped" ? Theme.tripped : on && glide ? transparent : on ? Theme.sel-soft : flat ? transparent : Theme.raised;
    border-color: kind == "go" ? Theme.go-border : kind == "hold" ? Theme.hold-border : kind == "stop" ? Theme.stop-border
        : kind == "tripped" ? Theme.stop-border : on ? Theme.sel : Theme.raised-border;
    border-width: kind == "tripped" ? 3px : on && glide ? 0 : on && !filled ? 2px : flat ? 0 : 1px;
    opacity: enabled ? 1.0 : 0.38;
    clip: true;
    animate background, border-color, opacity { duration: Theme.quick; }
    property <color> ink: filled || kind == "tripped" ? Theme.on-fill : on || accent ? Theme.sel-ink : flat ? Theme.muted : Theme.ink;

    Rectangle {
        background: touch.pressed && enabled ? Theme.press : transparent;
        // Lights at once under the finger, fades when it lifts.
        animate background { duration: touch.pressed ? 0ms : 200ms; }
    }
    Rectangle {
        x: 0;
        width: arming ? parent.width : 0;
        background: Theme.sweep;
        animate width { duration: root.arming ? 800ms : 0ms; }
    }
    // The label is always centred. The corner tag means one thing only:
    // HOLD (the press must last). A `sub` caption is a small second line
    // under the label.
    VerticalLayout {
        alignment: center;
        spacing: (sub != "" || cap != "") && icon == "" ? 0px : 4px;
        padding-left: menu ? 34px : 10px;
        padding-right: menu ? 34px : 10px;
        if icon != "": HorizontalLayout {
            alignment: center;
            Path {
                width: 30px;
                height: 30px;
                commands: icon;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: root.ink;
                stroke-width: 2px;
                fill: transparent;
            }
        }
        if cap != "": Text {
            text: root.cap;
            font-family: Theme.display;
            font-size: Theme.t-tag;
            letter-spacing: 1.4px;
            color: filled ? Theme.on-fill-dim : Theme.dim;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.text != "": Text {
            text: root.text;
            font-family: root.family;
            font-size: root.font-size;
            letter-spacing: root.family == Theme.display ? 0.05 * root.font-size : 0;
            color: root.ink;
            animate color { duration: Theme.quick; }
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if sub != "": Text {
            text: root.sub;
            font-family: Theme.display;
            font-size: Theme.t-tag;
            letter-spacing: 1.4px;
            color: filled ? Theme.on-fill-dim : on ? Theme.sel-ink : Theme.muted;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    if hold: Text {
        x: root.width - self.width - 9px;
        y: 3px;
        text: "HOLD";
        font-family: Theme.display;
        font-size: Theme.t-tag;
        letter-spacing: 1.4px;
        color: filled ? Theme.on-fill-dim : Theme.muted;
    }
    if menu: Chevron { x: root.width - 34px; y: (root.height - self.height) / 2; color: root.ink; }
    hold-timer := Timer {
        interval: 800ms;
        running: root.arming && !root.fired;
        triggered => {
            root.fired = true;
            root.clicked();
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                // A hold counts only if the button was a hold button when the
                // touch began: E-STOP turns into RESET under the finger, and
                // keeping the finger down must not reset it.
                root.fired = !root.hold;
                root.touch-held = root.hold;
                root.pressed();
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.released();
            }
        }
        // A plain tap clicks on release, but only if the button is still a
        // plain button: when it became a hold button under the finger
        // (E-STOP tripped on touch-down and turned into RESET), the release
        // must not act. Without this, a press long enough for the E-stop to
        // show tripped reset it on release.
        clicked => {
            if !root.touch-held && !root.hold { root.clicked(); }
        }
    }
}

// A button in a row of equals: every EqBtn in a layout gets the same width
// whatever its label, so CANCEL / ENTER and the like line up.
export component EqBtn inherits Btn {
    preferred-width: 0;
    min-width: 0;
    horizontal-stretch: 1;
}

// A status pill: a coloured dot and a label on a quiet capsule.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <string> kind;
    // The "on" half of a flashing pill: filled, so it is seen from across the shop.
    in property <bool> lit;
    // Flashing: `lit` toggles twice a second. Hard on/off, no fade: a fade
    // would animate (and on the GPU redraw the whole screen) all the time.
    in property <bool> blinking;
    // "down" / "up": the pill opens a list.
    in property <string> caret;
    property <duration> fade: blinking ? 0ms : Theme.settle;
    property <color> tone: kind == "good" ? Theme.good : kind == "warn" ? Theme.warn : kind == "bad" ? Theme.bad : kind == "info" ? Theme.info : Theme.dim;
    height: 38px;
    horizontal-stretch: 0;
    border-radius: 19px;
    // A quiet tint of its tone, so the capsule shows on a card as on the bar.
    background: lit ? Theme.stop : kind == "bad" ? Theme.bad-soft : kind == "warn" ? Theme.warn-soft : kind == "good" ? Theme.good-soft : kind == "info" ? Theme.info-soft : Theme.faint;
    animate background { duration: fade; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 9px; height: 9px; border-radius: 4.5px; background: lit ? Theme.ink : tone; animate background { duration: fade; } }
        }
        Text {
            vertical-alignment: center;
            text: root.text;
            font-family: Theme.display;
            font-size: Theme.t-body;
            letter-spacing: 1.2px;
            color: lit ? Theme.ink : kind == "" ? Theme.muted : tone;
            animate color { duration: fade; }
        }
        if caret != "": VerticalLayout {
            alignment: center;
            Chevron { width: 16px; height: 16px; dir: root.caret; color: lit ? Theme.ink : kind == "" ? Theme.muted : tone; }
        }
    }
}

export component Label inherits Text {
    font-family: Theme.display;
    font-size: Theme.t-body;
    letter-spacing: 1.6px;
    color: Theme.muted;
}

// The small spaced caption over a value, a tile or a well.
export component Caption inherits Text {
    font-family: Theme.display;
    font-size: Theme.t-cap;
    letter-spacing: 1.4px;
    color: Theme.dim;
}

export component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius;
}

// Segment of a segmented control: segments sit side by side (spacing 0) and
// share one track; the chosen one is a tinted pill inside it. Mark the outer
// segments `first` / `last` to round the ends of the track.
export component Seg inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <bool> first;
    in property <bool> last;
    in property <length> font-size: Theme.t-btn;
    callback clicked();
    preferred-height: Theme.h-ctl;
    min-width: 40px;
    horizontal-stretch: 1;
    opacity: enabled ? 1.0 : 0.38;
    border-top-left-radius: first ? Theme.radius-ctl : 0;
    border-bottom-left-radius: first ? Theme.radius-ctl : 0;
    border-top-right-radius: last ? Theme.radius-ctl : 0;
    border-bottom-right-radius: last ? Theme.radius-ctl : 0;
    background: Theme.well;
    Rectangle {
        x: 3px; y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-radius: Theme.radius-sm;
        // Unchosen segments keep a faint plate so each reads as a target.
        background: root.on ? Theme.sel-soft : touch.pressed && root.enabled ? Theme.faint-press : Theme.faint;
        border-width: 2px;
        border-color: root.on ? Theme.sel : transparent;
        animate background, border-color { duration: Theme.quick; }
    }
    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        font-family: Theme.display;
        font-size: root.font-size;
        letter-spacing: 0.05 * root.font-size;
        color: root.on ? Theme.sel-ink : Theme.muted;
        animate color { duration: Theme.quick; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// A value well that opens the keypad when tapped: the one look for "a
// number you tap to change". The value is right-aligned with its unit small
// and dim after it. `changed` marks a value that differs from its default.
export component NumField inherits Rectangle {
    in property <string> value;
    in property <string> unit;
    in property <bool> enabled: true;
    in property <bool> changed;
    callback edit();
    height: Theme.h-ctl;
    background: Theme.well;
    border-width: 1px;
    border-color: touch.pressed ? Theme.sel : changed ? Theme.hold-border : Theme.raised-border;
    border-radius: Theme.radius-ctl;
    animate border-color { duration: touch.pressed ? 0ms : 200ms; }
    opacity: enabled ? 1 : 0.38;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: end;
        Text { vertical-alignment: center; text: value; font-family: Theme.body; font-weight: 600; font-size: Theme.t-value; color: Theme.ink; }
        if unit != "": Text { vertical-alignment: center; text: unit; font-family: Theme.body; font-size: Theme.t-small; color: Theme.dim; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.edit(); } }
}

// The same value as a tile: caption above, value below, left-aligned. For
// grids of inputs (CONV). `choice` marks one that opens a list instead of
// the keypad: a raised plate with a chevron.
export component FieldTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <bool> choice;
    // An empty slot keeps a grid's columns when the count is odd.
    in property <bool> empty;
    in property <bool> enabled: true;
    callback edit();
    height: 76px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-ctl;
    background: empty ? transparent : choice ? Theme.raised : Theme.well;
    border-width: empty ? 0 : 1px;
    border-color: touch.pressed ? Theme.sel : Theme.raised-border;
    opacity: enabled ? 1 : 0.38;
    animate border-color { duration: touch.pressed ? 0ms : 200ms; }
    if !empty: Caption {
        x: 16px; y: 9px;
        width: parent.width - 32px;
        text: root.label;
        overflow: elide;
    }
    if !empty: HorizontalLayout {
        x: 16px; y: 30px;
        width: parent.width - (choice ? 60px : 32px);
        height: 38px;
        spacing: 6px;
        alignment: start;
        Text { vertical-alignment: center; text: root.value; font-family: Theme.body; font-weight: 600; font-size: Theme.t-value; color: Theme.ink; overflow: elide; }
        if unit != "": Text { vertical-alignment: center; text: root.unit; font-family: Theme.body; font-size: Theme.t-small; color: Theme.dim; }
    }
    if !empty && choice: Chevron { x: parent.width - 38px; y: (parent.height - self.height) / 2; }
    touch := TouchArea { enabled: !empty && root.enabled; clicked => { root.edit(); } }
}

// A caption and the value under it: a fact to read, not a control. `inset`
// for a tile on a card (one tone up); the default sits on the frame.
export component Kv inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.ink;
    in property <bool> inset;
    height: 64px;
    background: inset ? Theme.panel2 : Theme.panel;
    border-radius: Theme.radius-ctl;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 7px;
        spacing: 1px;
        alignment: start;
        Caption { text: label; overflow: elide; }
        Text { text: value; font-family: Theme.body; font-weight: 600; font-size: Theme.t-value; color: root.tone; overflow: elide; }
    }
}

export component H3 inherits Text {
    font-family: Theme.display;
    font-size: Theme.t-value;
    letter-spacing: 1.8px;
    color: Theme.ink;
}

export component Note inherits Text {
    font-family: Theme.body;
    font-size: Theme.t-body;
    color: Theme.muted;
    wrap: word-wrap;
}

// Wraps something that has just appeared (a screen, a tab's panel): it
// fades in and rises into place once, then sits still. The fade is a
// layer only while it runs; at full opacity it draws directly again.
export component Arrive inherits Rectangle {
    // Start values are plain constants, set to their end values in init:
    // Slint animates that assignment (a binding that flips in init would
    // just start at its end value).
    opacity: 0;
    property <length> lift: 12px;
    init => {
        self.opacity = 1;
        self.lift = 0px;
    }
    animate opacity, lift { duration: Theme.enter; easing: ease-out; }
    Rectangle {
        y: root.lift;
        @children
    }
}
