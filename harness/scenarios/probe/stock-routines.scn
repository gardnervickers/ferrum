title A stock machine runs PROBE with millgui's own macros: left edge and top face of the stock block
needs stock
# stock.py's block (mm: X 40..120, Y -60..-10, top -100; inch: X 1.5..4.5,
# Y -2.5..-0.5, top -4), in tip Z; the tip is machine Z less T99's length.
# Starting values for the probe (probe_defaults.rs); the ball radius is
# exactly D/2 in this sim. M61 sets T99 without a change, so the tool change
# style (loop or dialog) does not matter.
include ../common/ready.scn
mdi M61 Q99 G43
idle 30
expect stat.tool_in_spindle == 99
mdi G54
mdi G10 L2 P1 X0 Y0 Z0
screen probe
do probe-mode "find"
do probe-wcs "G54"
# LEFT EDGE: outside X ${block_left}, the tip below the top.
do probe-shape "block"
do probe-opt "angle-off"
mdi G53 G0 Z${probe_up_z}
mdi G53 G0 X${probe_left_x} Y${block_y}
mdi G53 G1 Z${probe_side_z} F${probe_feed}
do probe-target "e-l"
# The values are in the machine's units.
expect prop.pr-params[1].unit == ${unit}
include ../common/probe-run.scn
expect stat.g5x_offset[0] ~= ${block_left} +- ${probe_fine}
expect stat.g5x_offset[1] ~= 0 +- 0.0001
expect stat.g5x_offset[2] ~= 0 +- 0.0001
# TOP FACE: the tip above the middle of the block.
mdi G53 G0 Z${probe_up_z}
mdi G53 G0 X${block_x} Y${block_y}
do probe-shape "top"
do probe-target "top"
expect prop.pr-more contains "${unit}/min"   # a feed among the top face values
include ../common/probe-run.scn
expect stat.g5x_offset[2] ~= ${block_top} +- ${probe_fine}
expect stat.g5x_offset[0] ~= ${block_left} +- ${probe_fine}
mdi G53 G0 Z${probe_up_z}
shot stock-routines-done
expect ui-errors.len == 0
