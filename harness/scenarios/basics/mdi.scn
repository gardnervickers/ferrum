title MDI moves, work offsets and the DRO
include ../common/ready.scn
include ../common/work-zero.scn
expect stat.actual_position[0] ~= ${safe_x}
expect stat.actual_position[1] ~= ${safe_y}
expect stat.actual_position[2] ~= ${safe_z}
expect prop.dro-pos[0].work ~= 0
expect prop.dro-pos[0].mach ~= ${safe_x}
mdi G0 X${dist}
expect prop.dro-pos[0].work ~= ${dist}
expect stat.position[0] ~= ${safe_x} +- 1000   # sanity: still a number
screen run
shot mdi-done
