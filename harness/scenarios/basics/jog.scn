title One jog step on X moves exactly one step
xfail stock: C1, stock INCREMENTS ("1 mm", ".1in") are not parsed yet
include ../common/ready.scn
screen manual
expect prop.jog-steps contains "${jog_label}"
do jog-step-set "${jog_label}"
expect prop.jog-step == "${jog_label}"
do jog-start 0 1
idle 20
expect stat.position[0] ~= ${jog_x_after}
shot after-jog
