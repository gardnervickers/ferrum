title RUN FROM SELECTED: runs from the line, STOP brings the original back
include ../common/ready.scn
include ../common/work-zero.scn
screen files
tap files name h_square.ngc files-tap
do files-load
wait stat.file contains h_square.ngc within 10
screen run
wait prop.plot-summary contains " OP" within 30
# From line 6 (G1 X0): the copy goes over X dist Y dist first, then cuts.
set gcode-selected 5
sleep 0.5
do gcode-run-from-selected
wait stat.interp_state != 1 within 10
wait stat.file contains ferrum-restart within 5
idle 60
expect prop.dro-pos[0].work ~= 0
expect prop.dro-pos[1].work ~= 0
wait stat.file !contains ferrum-restart within 10
expect stat.file contains h_square.ngc
expect prop.gcode-lines contains "G1 Y"
# STOP part way: the original is loaded again, nothing else runs.
set gcode-selected 3
sleep 0.5
do gcode-run-from-selected
wait stat.interp_state != 1 within 10
wait stat.current_vel > 0 within 10
do stop
wait stat.interp_state == 1 within 10
wait stat.file !contains ferrum-restart within 10
expect stat.file contains h_square.ngc
sleep 2
expect stat.interp_state == 1
# Single block on: RUN FROM SELECTED is a single-stepped start too.
do single-block
set gcode-selected 5
sleep 0.5
do gcode-run-from-selected
wait stat.interp_state != 1 within 10
sleep 2
expect stat.current_vel == 0
do stop
wait stat.interp_state == 1 within 10
wait stat.file !contains ferrum-restart within 10
