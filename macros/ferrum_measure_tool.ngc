; Part of millgui. MIT licence, see millgui/LICENSE.
; One-tap tool length (TOOLS › MEASURE): o<millgui_measure_tool> call [tool].
; Loads the tool if another one is in the spindle (a normal M6, so the
; machine's tool change runs as usual), turns its length offset on (G43)
; and measures it on the setter with o<tool_touch_off>, which writes the
; length to the tool table. G43 then applies the new length. Any abort
; (the tool change, the setter) stops it before the next step.
o<millgui_measure_tool> sub
o10 if [#<_task> EQ 0]
    o<millgui_measure_tool> return
o10 endif
#<tool> = #1
o100 if [[#<tool> LE 0] OR [FIX[#<tool>] NE #<tool>]]
    (ABORT, Pick a tool to measure)
o100 endif
o110 if [#<tool> EQ #3014]
    (ABORT, The probe is not measured on the tool setter: calibrate it on a reference surface)
o110 endif
o120 if [#5400 NE #<tool>]
    M5
    M9
    T#<tool> M6
o120 endif
G43
o<tool_touch_off> call
G43
o<millgui_measure_tool> endsub
M2
