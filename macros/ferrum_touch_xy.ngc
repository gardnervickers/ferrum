; Part of ferrum. MIT licence, see ferrum/LICENSE.
; One precise probe touch in any XY direction:
; o<ferrum_touch_xy> call [angle] [max]. [angle] is the direction the
; probe moves, in degrees counter-clockwise from +X seen from above; [max]
; is the search distance in machine units from the current position. The
; same touch as o<ferrum_touch> (fast G38.2 at #3016, back off #3019 at
; #3017, the part of the back-off beyond the travelled stretch guarded,
; optional slow touch of 2 x #3019 at #3015), along the line instead of
; one axis. The stylus-centre contact (no tip compensation) is returned in
; #<_ferrum_hit_x> and #<_ferrum_hit_y>; the probe ends #3019 back from
; the surface on the side it came from. Modal state is restored (M73).
o<ferrum_touch_xy> sub
#<ang> = #1
#<max> = #2
o100 if [#<max> LE 0]
    (ABORT, Probe search distance must be positive)
o100 endif
#<clear> = #3019
o110 if [[#<clear> LE 0] OR [#3016 LE 0] OR [#3017 LE 0] OR [#3015 LT 0]]
    (ABORT, Probe feeds and clearances must be positive)
o110 endif

M73
G90 G94
#<ux> = COS[#<ang>]
#<uy> = SIN[#<ang>]
#<sx> = #5420
#<sy> = #5421

; 1. Fast touch.
G91 G38.2 X[#<ux> * #<max>] Y[#<uy> * #<max>] F#3016
#<hx> = #5061
#<hy> = #5062

; 2. Back off by the clearance, unguarded only over the travelled stretch.
#<travel> = SQRT[[#<hx> - #<sx>] ** 2 + [#<hy> - #<sy>] ** 2]
#<back> = #<clear>
o200 if [#<back> GT #<travel>]
    #<back> = #<travel>
o200 endif
G90 G1 X[#<hx> - #<ux> * #<back>] Y[#<hy> - #<uy> * #<back>] F#3017
o210 if [#<clear> GT #<travel>]
    G90 G38.3 X[#<hx> - #<ux> * #<clear>] Y[#<hy> - #<uy> * #<clear>] F#3017
    o220 if [[#<_task> EQ 1] AND [#5070 EQ 1]]
        (ABORT, Probe made unexpected contact while backing off)
    o220 endif
o210 endif

; 3. Optional slow touch from the clearance distance.
o300 if [#3015 GT 0]
    G91 G38.2 X[#<ux> * 2 * #<clear>] Y[#<uy> * 2 * #<clear>] F#3015
    #<hx> = #5061
    #<hy> = #5062
    G90 G1 X[#<hx> - #<ux> * #<clear>] Y[#<hy> - #<uy> * #<clear>] F#3017
o300 endif

#<_ferrum_hit_x> = #<hx>
#<_ferrum_hit_y> = #<hy>
o<ferrum_touch_xy> endsub
M2
