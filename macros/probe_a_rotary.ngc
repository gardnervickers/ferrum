; Part of ferrum. MIT licence, see ferrum/LICENSE.
; FIND A0 on a flat: o<probe_a_rotary> call [dir]; dir 1 when +A moves the
; top of the work towards the operator, -1 the other way (0 counts as 1).
; Work on the A axis (parallel to X) carries a flat facing up; the probe
; starts above it at least 2.5 mm from work Y0. It touches the flat there
; (search 2 x #3021), rises #3021, makes a guarded move to the mirror point
; across Y0, touches again and rises #3021. The flat's tilt is
; atan2(Z on the +Y side - Z on the -Y side, Y distance) in degrees. With
; #3030 = 0 the active work offset's A is set so the current position reads
; A = dir x tilt, which makes A0 the level orientation. No result lines.
; Ends above the mirror point, A unchanged. Modes are restored (M73).
o<probe_a_rotary> sub
o10 if [#<_task> EQ 0]
    o<probe_a_rotary> return
o10 endif
o<ferrum_rotary_ready> call [0]
M73
M50 P0
G90 G94
#<dir> = #1
o20 if [#<dir> EQ 0]
    #<dir> = 1
o20 endif
#<y1> = #5421
o30 if [ABS[#<y1>] LT [2.5 * #<_ferrum_mm>]]
    (ABORT, Start at least 2.5 mm away from work Y0 for the A0 flat probe)
o30 endif
o<ferrum_touch> call [2] [-1] [2 * #3021]
#<z1> = #<_ferrum_hit>
o<ferrum_guarded_move> call [0] [0] [#<z1> + #3021 - #5422]
o<ferrum_guarded_move> call [0] [[0 - #<y1>] - #5421] [0]
o<ferrum_touch> call [2] [-1] [2 * #3021]
#<z2> = #<_ferrum_hit>
o<ferrum_guarded_move> call [0] [0] [#<z2> + #3021 - #5422]
o40 if [#<y1> GT 0]
    #<angle> = [ATAN[#<z1> - #<z2>]/[2 * ABS[#<y1>]]]
o40 else
    #<angle> = [ATAN[#<z2> - #<z1>]/[2 * ABS[#<y1>]]]
o40 endif
o50 if [#3030 EQ 0]
    G10 L20 P0 A[#<dir> * #<angle>]
o50 endif
G90
o<probe_a_rotary> endsub
M2
