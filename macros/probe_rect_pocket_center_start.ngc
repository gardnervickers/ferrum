; FIND/MEASURE pocket centre: finds the centre and size of a rectangular
; pocket. The probe starts inside the pocket near its centre with the tip
; below the top edge; there is no Z motion. One pass: across X (-X wall,
; then +X, hint #3026) and to the X centre, then across Y (+Y wall, then
; -Y, hint #3027) and to the Y centre. Reports x_probed_width #1001,
; x_center_probed #1002, y_probed_width #1003, y_center_probed #1004. With
; #3030 = 0 the active work offset gets X0 Y0 at the centre. Ends at the
; centre, same Z.
o<probe_rect_pocket_center_start> sub
o10 if [#<_task> EQ 0]
    o<probe_rect_pocket_center_start> return
o10 endif
o<ferrum_probe_ready> call
M73
M50 P0
G90 G94

o<ferrum_span_inside> call [0] [#3026] [#3032]
#1001 = #<_ferrum_width>
#1002 = #<_ferrum_center>
o<ferrum_span_inside> call [1] [#3027] [#3032]
#1003 = #<_ferrum_width>
#1004 = #<_ferrum_center>

(DEBUG, EVAL[vcp.getWidget{"x_probed_width"}.setValue{#1001}])
(DEBUG, EVAL[vcp.getWidget{"x_center_probed"}.setValue{#1002}])
(DEBUG, EVAL[vcp.getWidget{"y_probed_width"}.setValue{#1003}])
(DEBUG, EVAL[vcp.getWidget{"y_center_probed"}.setValue{#1004}])

o30 if [#3030 EQ 0]
    G10 L20 P0 X[#5420 - #1002] Y[#5421 - #1004]
o30 endif
G90
o<probe_rect_pocket_center_start> endsub
M2
