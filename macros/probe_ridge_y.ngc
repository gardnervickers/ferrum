; Part of ferrum. MIT licence, see ferrum/LICENSE.
; FIND/MEASURE ridge across Y: finds the top, centre and width of a ridge
; (a rib running along X) across Y. The probe starts above the ridge's
; middle, within #3020 of its top. It touches the top, steps out to one side
; by #3029/2 + #3023 (width hint #3029), plunges #3021 + tip diameter + #3022
; below the clearance height, touches towards the ridge, rises, does the
; same from the other side, and moves over the centre. Every positioning
; move is guarded. Reports z_minus_probed_position #1009 (the top, before
; any write), y_probed_width #1003 and y_center_probed #1004. With #3030 = 0
; the active work offset gets Z0 at the top and Y0 at the centre. Ends over
; the centre, #3021 above the top.
o<probe_ridge_y> sub
o10 if [#<_task> EQ 0]
    o<probe_ridge_y> return
o10 endif
o<ferrum_probe_ready> call
M73
M50 P0
G90 G94

o<ferrum_touch> call [2] [-1] [#3020]
#1009 = #<_ferrum_hit>
#<z_clear> = [#1009 + #3021]
#<z_probe> = [#1009 - #5410 - #3022]
o<ferrum_guarded_move> call [0] [0] [#<z_clear> - #5422]

o<ferrum_span_outside> call [1] [#3029] [#<z_clear>] [#<z_probe>]
#1003 = #<_ferrum_width>
#1004 = #<_ferrum_center>

(DEBUG, EVAL[vcp.getWidget{"z_minus_probed_position"}.setValue{#1009}])
(DEBUG, EVAL[vcp.getWidget{"y_probed_width"}.setValue{#1003}])
(DEBUG, EVAL[vcp.getWidget{"y_center_probed"}.setValue{#1004}])

o30 if [#3030 EQ 0]
    G10 L20 P0 Y[#5421 - #1004] Z[#5422 - #1009]
o30 endif
G90
o<probe_ridge_y> endsub
M2
