# DEPRECATED: an older profile without a [hal] table in ferrum.toml runs this
# file. Ferrum ignores it once ferrum.toml has [hal] (docs/hal.md).
# probe module: probe_manager state (mymill.hal).
net wireless-probe-tool-active => ferrum.probe.wireless-selected
net wireless-probe-fault => ferrum.probe.fault
net probe-in => ferrum.probe.tripped
# Tool setter air blast (UTIL): a pulse on the manual request input of the
# or2 in mymill.hal; touchsetter-blast-pulse times the air itself.
net ferrum-blast-request ferrum.probe.blast-request => touchsetter-blast-manual-request-pin
net touchsetter-blast-active => ferrum.probe.blast-active
net toolsetter-triggered => ferrum.probe.toolsetter
